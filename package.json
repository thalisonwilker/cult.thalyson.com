{
  "name": "cult.thalyson.com",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test:unit": "vitest run",
    "test": "vitest run",
    "docker:build": "docker build -t cult-thalyson:latest .",
    "docker:run": "docker run --rm -p 8080:8080 cult-thalyson:latest",
    "docker:test": "bash scripts/test-docker.sh"
  },
  "dependencies": {
    "astro": "^5.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.6.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
