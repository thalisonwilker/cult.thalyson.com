---
// src/components/CategoryNavigation.astro
interface CategoryItem {
  slug: string;
  name: string;
  desc: string;
  icon: string;
  accent: string;
}

const categories: CategoryItem[] = [
  {
    slug: 'musica',
    name: 'Música & Ritmos',
    desc: 'Do carimbó tradicional e da guitarrada aos sons de aparelhagens e jazz.',
    icon: 'fa-solid fa-drum',
    accent: 'var(--color-cult-gold)'
  },
  {
    slug: 'patrimonio',
    name: 'Círio & Patrimônio',
    desc: 'A fé ribeirinha, a corda, as mangueiras e os saberes orais de Belém.',
    icon: 'fa-solid fa-hands-praying',
    accent: 'var(--color-cult-coral)'
  },
  {
    slug: 'artes',
    name: 'Arte, Cinema & Imagem',
    desc: 'Narrativas audiovisuais, estética dos barcos e vanguardas visuais amazônicas.',
    icon: 'fa-solid fa-camera-retro',
    accent: 'var(--color-cult-cobalt)'
  },
  {
    slug: 'literatura',
    name: 'Literatura Paraense',
    desc: 'Vozes das marés, poéticas da floresta e diálogos com o cânone universal.',
    icon: 'fa-solid fa-book-open',
    accent: 'var(--color-cult-turquoise)'
  }
];
---

<section class="explore-culture-section" aria-label="Explore as Vertentes Culturais">
  <div class="section-header-editorial">
    <div class="header-title-wrap">
      <span class="section-tag-editorial">
        <i class="fa-solid fa-compass" aria-hidden="true"></i> Horizontes Editoriais
      </span>
      <h2 class="section-title-editorial">Explore a Cultura</h2>
    </div>
  </div>

  <div class="categories-grid">
    {categories.map((cat) => (
      <a
        href={`/?categoria=${cat.slug}`}
        class="category-editorial-card"
        style={`--card-accent: ${cat.accent};`}
      >
        <div class="card-accent-bar" aria-hidden="true"></div>
        <div class="card-header-row">
          <i class={`category-icon ${cat.icon}`} aria-hidden="true"></i>
          <span class="view-link-indicator">
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
          </span>
        </div>
        <h3 class="category-name">{cat.name}</h3>
        <p class="category-desc">{cat.desc}</p>
      </a>
    ))}
  </div>
</section>

<style>
  /* ============================================================
     Explore Culture Section
     ============================================================ */
  .explore-culture-section {
    margin-bottom: var(--space-24);
  }

  .header-title-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .section-note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-cult-text-dim);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  /* Cards Tipográficos Refinados (Sem Aparência de Dashboard) */
  .category-editorial-card {
    background-color: var(--color-cult-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .card-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--card-accent);
    transform: scaleX(0.3);
    transform-origin: left;
    transition: transform var(--transition-normal);
  }

  .category-editorial-card:hover .card-accent-bar {
    transform: scaleX(1);
  }

  .category-editorial-card:hover {
    transform: translate(-2px, -2px);
    border-color: var(--card-accent);
    border-bottom: 3px solid var(--card-accent);
    box-shadow: 4px 4px 0 var(--card-accent);
    background-color: var(--color-cult-surface-hover);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .category-icon {
    font-size: 1.2rem;
    color: var(--card-accent);
    transition: transform var(--transition-fast);
  }

  .category-editorial-card:hover .category-icon {
    transform: scale(1.1);
  }

  .view-link-indicator {
    font-size: 0.75rem;
    color: var(--color-cult-text-dim);
    transition: color var(--transition-fast);
  }

  .category-editorial-card:hover .view-link-indicator {
    color: var(--card-accent);
  }

  .category-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-cult-text);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .category-desc {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-cult-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: var(--space-3);
    }

    .category-editorial-card {
      padding: var(--space-4);
    }

    .category-name {
      font-size: 1.05rem;
    }
  }
</style>
