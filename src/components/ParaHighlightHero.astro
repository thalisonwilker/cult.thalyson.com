---
// src/components/ParaHighlightHero.astro
const paraPillars = [
  {
    title: 'Carimbó & Tradição',
    desc: 'O tambor curimbó, a ginga cabocla de Dona Onete e Mestre Verequete.',
    tag: 'Música',
    icon: 'fa-solid fa-drum',
    color: 'var(--color-fusion-red)',
    link: '/ensaios/o-banzeiro-do-carimbo-e-a-voz-de-dona-onete'
  },
  {
    title: 'Guitarrada Elétrica',
    desc: 'O som amazônico das cordas de Mestre Vieira e o merengue das marés.',
    tag: 'Instrumental',
    icon: 'fa-solid fa-guitar',
    color: 'var(--color-orange-hibiscus)',
    link: '/ensaios/mestre-vieira-e-a-invencao-da-guitarrada-eletrica'
  },
  {
    title: 'O Círio & O Sagrado',
    desc: 'Dois milhões de vozes sob as mangueiras, a corda e os brinquedos de miriti.',
    tag: 'Patrimônio',
    icon: 'fa-solid fa-hands-praying',
    color: 'var(--color-sun-glow)',
    link: '/ensaios/o-cirio-de-nazare-e-a-estetica-do-sagrado-ribeirinho'
  },
  {
    title: 'Abridores de Letras',
    desc: 'A tipografia vernacular pintada nos barcos fluviais que cruzam o Guajará.',
    tag: 'Artes Visuais',
    icon: 'fa-solid fa-paintbrush',
    color: 'var(--color-electric-cyan)',
    link: '/ensaios/os-abridores-de-letras-e-a-tipografia-fluvial-da-amazonia'
  }
];
---

<section class="para-hero">
  <div class="para-hero-grid">
    <div class="para-hero-content">
      <div class="location-badge">
        <i class="fa-solid fa-water location-icon" aria-hidden="true"></i>
        <span>Belém do Pará · Amazônia Atlântica</span>
      </div>
      <h1 class="para-hero-title">
        O pulsar da cultura paraense, do banzeiro dos rios ao som das aparelhagens.
      </h1>
      <p class="para-hero-lead">
        Um acervo crítico e afetivo dedicado à música, cinema, literatura cabocla, saberes do Ver-o-Peso e artes visuais do Pará — com pontes e diálogos com o cenário nacional e global.
      </p>
    </div>

    <div class="para-hero-artwork">
      <div class="artwork-frame">
        <img
          src="/images/belem-noite-estrelada.jpg"
          alt="Pintura expressionista a óleo da Baía do Guajará em Belém do Pará sob uma noite estrelada em espiral no estilo Van Gogh"
          class="artwork-img"
          loading="eager"
        />
        <div class="artwork-caption">
          <i class="fa-solid fa-palette caption-icon"></i>
          <span>Noite Estrelada no Guajará — Óleo sobre tela</span>
        </div>
      </div>
    </div>
  </div>

  <div class="pillars-grid">
    {paraPillars.map((pillar) => (
      <a href={pillar.link} class="pillar-card" style={`--accent-color: ${pillar.color};`}>
        <div class="pillar-header-row">
          <div class="pillar-tag">{pillar.tag}</div>
          <i class={`pillar-icon ${pillar.icon}`} aria-hidden="true"></i>
        </div>
        <h3 class="pillar-title">{pillar.title}</h3>
        <p class="pillar-desc">{pillar.desc}</p>
        <span class="pillar-link">
          Ler ensaio <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .para-hero {
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2.25rem;
    margin-bottom: 3.5rem;
    box-shadow: var(--shadow-artistic);
    position: relative;
    overflow: hidden;
  }

  .para-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(
      90deg,
      var(--color-fusion-red),
      var(--color-orange-hibiscus),
      var(--color-sun-glow),
      var(--color-electric-cyan),
      var(--color-twilight-magenta)
    );
  }

  .para-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 2.75rem;
  }

  .para-hero-content {
    max-width: 620px;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-beniukon-bronze);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
  }

  .location-icon {
    color: var(--color-electric-cyan);
    font-size: 0.9rem;
  }

  .para-hero-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .para-hero-lead {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* Artwork Frame */
  .para-hero-artwork {
    display: flex;
    justify-content: center;
  }

  .artwork-frame {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    border: 3px solid var(--color-border);
    background-color: var(--color-cosmic-night);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .artwork-frame:hover {
    transform: scale(1.02);
    box-shadow: 0 14px 40px rgba(0, 210, 211, 0.25);
  }

  .artwork-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .artwork-caption {
    background: rgba(10, 17, 40, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #f0f4fc;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    padding: 0.4rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .caption-icon {
    color: var(--color-sun-glow);
  }

  /* Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .pillar-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    border-top: 3px solid var(--accent-color);
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-color);
    box-shadow: var(--shadow-md);
  }

  .pillar-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .pillar-icon {
    font-size: 0.95rem;
    color: var(--accent-color);
    opacity: 0.9;
  }

  .pillar-tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .pillar-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .pillar-desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex: 1;
  }

  .pillar-link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  @media (max-width: 900px) {
    .para-hero-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (max-width: 768px) {
    .para-hero {
      padding: 1.75rem 1.25rem;
    }
    .para-hero-title {
      font-size: 2rem;
    }
    .para-hero-lead {
      font-size: 1.05rem;
    }
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
