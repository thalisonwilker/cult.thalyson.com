---
// src/components/EditorialHero.astro
interface Props {
  coverImage?: string;
  headline?: string;
  lead?: string;
  ctaLink?: string;
  ctaText?: string;
}

const {
  coverImage = '/images/docas-belem-noite-estrelada.jpg',
  headline = 'Belém entre arte, música e memória amazônica',
  lead = 'Das margens caudalosas do Guajará aos acordes elétricos das periferias: um mergulho nas sonoridades, saberes ribeirinhos e vanguardas estéticas do Pará.',
  ctaLink = '#em-destaque',
  ctaText = 'Explorar histórias'
} = Astro.props;

const isDefaultHeadline = headline === 'Belém entre arte, música e memória amazônica';
---

<section class="editorial-hero" aria-label="História Principal da Edição">
  <div class="hero-frame">
    <!-- Imagem de Fundo em Toda a Largura (Full-Width) -->
    <img
      src={coverImage}
      alt="Pintura expressionista noturna da Estação das Docas com os guindastes históricos amarelos e o céu estrelado em espirais sobre a Baía do Guajará em Belém do Pará"
      class="hero-media"
      loading="eager"
      decoding="async"
    />

    <!-- Atmosfera e Scrim Cinematográfico para Leitura Central Sem Caixa -->
    <div class="hero-scrim" aria-hidden="true"></div>

    <!-- Conteúdo Editorial Centralizado e Sem Caixa (Fora da Caixa com Destaques) -->
    <div class="hero-content-wrapper">
      <div class="hero-text-content">
        <h1 class="hero-headline">
          {isDefaultHeadline ? (
            <>
              Belém entre arte, música e memória amazônica
            </>
          ) : (
            headline
          )}
        </h1>

        <p class="hero-lead mb-4">
          {lead}
        </p>

        <!-- Botão de Gancho Centralizado com Efeitos Culturais de Belém -->
        <div class="hero-actions">
          <a href={ctaLink} class="hero-belem-btn" aria-label="Explorar histórias e saberes do Pará">
            <span class="btn-label">{ctaText}</span>
            <span class="btn-arrow" aria-hidden="true">
              <i class="fa-solid fa-arrow-down"></i>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     Editorial Hero — Imagem Full-Width com Textos Fora da Caixa
     ============================================================ */
  .editorial-hero {
    position: relative;
    width: 100%;
    margin-bottom: var(--space-12);
    padding: 0;
    overflow: hidden;
  }

  .hero-frame {
    position: relative;
    width: 100%;
    min-height: clamp(560px, 82vh, 820px);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-cult-navy-deep);
    overflow: hidden;
  }

  /* Imagem Nítida e Exuberante Ocupando Toda a Largura */
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(1.12) contrast(1.03);
    transform: scale(1.0);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-frame:hover .hero-media {
    transform: scale(1.02);
  }

  /* Scrim Cinematográfico Suave — Preserva o Céu Estrelado e Garante Contraste Perfeito */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      /* Iluminação sutil e profunda no centro para leitura dos textos fora da caixa */
      radial-gradient(
        ellipse 90% 70% at 50% 50%,
        rgba(7, 13, 34, 0.76) 0%,
        rgba(7, 13, 34, 0.5) 55%,
        transparent 100%
      ),
      /* Vinheta de transição suave do topo e fusão perfeita com a base */
      linear-gradient(
        180deg,
        rgba(7, 13, 34, 0.38) 0%,
        rgba(7, 13, 34, 0.22) 25%,
        rgba(7, 13, 34, 0.62) 65%,
        rgba(7, 13, 34, 0.95) 90%,
        var(--color-bg) 100%
      );
    pointer-events: none;
  }

  /* Conteúdo Editorial Centralizado e Aberto (Sem Caixa) */
  .hero-content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero-text-content {
    max-width: 980px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }

  /* Headline Dominante com Tipografia Editorial e Destaques Culturais */
  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.4vw, 4.3rem);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.14;
    letter-spacing: -0.025em;
    text-align: center;
    max-width: 980px;
    margin: 0;
    text-shadow:
      0 2px 8px rgba(3, 7, 18, 0.95),
      0 6px 24px rgba(7, 13, 34, 0.95),
      0 14px 44px rgba(3, 7, 18, 0.85);
  }

  /* Destaques Tipográficos Vivos Inspirados no Pará */
  .highlight-cyan {
    background: linear-gradient(135deg, #17A9B8 0%, #68D8D6 60%, #FFFFFF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: italic;
    font-weight: 600;
    filter: drop-shadow(0 2px 14px rgba(23, 169, 184, 0.65));
    display: inline-block;
    padding: 0 0.08em;
  }

  .highlight-gold {
    background: linear-gradient(135deg, #F4B63F 0%, #F27A32 50%, #EC5B5B 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    filter: drop-shadow(0 2px 16px rgba(244, 182, 63, 0.65));
    display: inline-block;
    padding: 0 0.08em;
  }

  /* Descrição Editorial Fluida e Centrada */
  .hero-lead {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.45vw, 1.28rem);
    line-height: 1.68;
    color: #E2EBF8;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    font-weight: 400;
    text-shadow:
      0 2px 10px rgba(3, 7, 18, 0.95),
      0 4px 20px rgba(7, 13, 34, 0.9);
  }

  /* Ações / Botão de Gancho Centralizado */
  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: var(--space-4);
  }

  /* Botão de Gancho com Efeitos Culturais de Belém */
  .hero-belem-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 2.4rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #FFFFFF;
    background: linear-gradient(135deg, #132a5c 0%, #17548a 45%, #17A9B8 100%);
    border: 1.5px solid rgba(244, 182, 63, 0.75);
    border-radius: var(--radius-pill);
    text-decoration: none;
    cursor: pointer;
    box-shadow:
      0 0 25px rgba(23, 169, 184, 0.45),
      0 0 14px rgba(244, 182, 63, 0.35),
      0 8px 32px rgba(3, 7, 18, 0.75);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Pulso e Ondas Culturais de Belém (Banzeiro do Guajará & Carimbó) */
  .hero-belem-btn::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, #EC5B5B, #F4B63F, #17A9B8, #2457A6);
    z-index: -1;
    opacity: 0.45;
    filter: blur(8px);
    animation: belemPulse 3.5s ease-in-out infinite;
  }

  /* Brilho e Reflexo das Águas Fluviais (Water Shimmer) */
  .hero-belem-btn::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -60%;
    width: 220%;
    height: 200%;
    background: linear-gradient(
      60deg,
      transparent 30%,
      rgba(255, 255, 255, 0.28) 50%,
      transparent 70%
    );
    transform: rotate(25deg);
    animation: waterShimmer 4s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-belem-btn:hover {
    transform: translateY(-4px) scale(1.03);
    background: linear-gradient(135deg, #18387a 0%, #1a68aa 45%, #1cc3d4 100%);
    border-color: #F4B63F;
    box-shadow:
      0 0 35px rgba(23, 169, 184, 0.7),
      0 0 22px rgba(244, 182, 63, 0.6),
      0 12px 38px rgba(3, 7, 18, 0.85);
  }

  .btn-water-icon {
    font-size: 1.05rem;
    color: #68D8D6;
    filter: drop-shadow(0 0 6px rgba(23, 169, 184, 0.8));
    transition: transform 0.3s ease;
  }

  .hero-belem-btn:hover .btn-water-icon {
    transform: scale(1.2) rotate(-8deg);
    color: #F4B63F;
  }

  .btn-arrow {
    font-size: 0.95rem;
    color: #F4B63F;
    filter: drop-shadow(0 0 5px rgba(244, 182, 63, 0.8));
    transition: transform 0.3s ease;
  }

  .hero-belem-btn:hover .btn-arrow {
    transform: translateY(4px);
  }

  @keyframes belemPulse {
    0%, 100% {
      opacity: 0.35;
      transform: scale(0.98);
    }
    50% {
      opacity: 0.75;
      transform: scale(1.03);
      filter: blur(12px);
    }
  }

  @keyframes waterShimmer {
    0% {
      transform: translateX(-100%) rotate(25deg);
    }
    35%, 100% {
      transform: translateX(100%) rotate(25deg);
    }
  }

  /* ============================================================
     Responsividade
     ============================================================ */
  @media (max-width: 900px) {
    .hero-frame {
      min-height: 560px;
    }

    .hero-content-wrapper {
      padding: var(--space-8) var(--space-4);
    }

    .hero-headline {
      font-size: clamp(2rem, 6vw, 3.2rem);
    }
  }

  @media (max-width: 640px) {
    .editorial-hero {
      margin-bottom: var(--space-8);
    }

    .hero-frame {
      min-height: 520px;
    }

    .hero-media {
      object-position: center 25%;
    }

    .hero-content-wrapper {
      padding: var(--space-6) var(--space-3);
    }

    .hero-headline {
      font-size: 1.85rem;
      line-height: 1.2;
    }

    .hero-lead {
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .hero-belem-btn {
      width: 100%;
      max-width: 320px;
      padding: 0.85rem 1.6rem;
      font-size: 0.95rem;
    }
  }
</style>
