---
// src/components/EditorialHero.astro
interface Props {
  coverImage?: string;
  headline?: string;
  lead?: string;
  ctaLink?: string;
  ctaText?: string;
}

const {
  coverImage = '/images/docas-belem-noite-estrelada.jpg',
  headline = 'Belém entre arte, música e memória amazônica',
  lead = 'Das margens caudalosas do Guajará aos acordes elétricos das periferias: um mergulho nas sonoridades, saberes ribeirinhos e vanguardas estéticas do Pará.',
  ctaLink = '#em-destaque',
  ctaText = 'Explorar histórias'
} = Astro.props;
---

<section class="editorial-hero" aria-label="História Principal da Edição">
  <div class="hero-frame">
    <!-- Imagem de Fundo de Alto Impacto (Nítida, Cores Vivas, Alta Saturação) -->
    <img
      src={coverImage}
      alt="Pintura expressionista noturna da Estação das Docas com os guindastes históricos amarelos e o céu estrelado em espirais sobre a Baía do Guajará em Belém do Pará"
      class="hero-media"
      loading="eager"
      decoding="async"
    />

    <!-- Gradient Localizado Exclusivamente para Leitura do Texto (Sem camada escura sobre toda a foto) -->
    <div class="hero-scrim" aria-hidden="true"></div>

    <!-- Conteúdo Editorial com Elementos Fluviais dos Abridores de Letras -->
    <div class="hero-content-wrapper">
      <div class="hero-text-content">
        <!-- Pequeno Filete Ornamental Fluvial Superior -->
        <div class="hero-fluvial-ornament" aria-hidden="true">
          <span class="filete-wing filete-wing--left"></span>
          <svg class="filete-star" width="28" height="18" viewBox="0 0 28 18" fill="none">
            <path d="M14 1 L16.5 6.5 L23 9 L16.5 11.5 L14 17 L11.5 11.5 L5 9 L11.5 6.5 Z" fill="#F4B63F" stroke="#FFF6E5" stroke-width="0.8"/>
            <circle cx="2" cy="9" r="2" fill="#17A9B8"/>
            <circle cx="26" cy="9" r="2" fill="#17A9B8"/>
          </svg>
          <span class="filete-wing filete-wing--right"></span>
        </div>

        <h1 class="hero-headline">
          {headline}
        </h1>

        <!-- Filete das Águas Fluviais sob o Título -->
        <div class="hero-river-line" aria-hidden="true">
          <svg width="120" height="8" viewBox="0 0 120 8" fill="none">
            <path d="M0 4 Q 30 1, 60 4 T 120 4" stroke="#17A9B8" stroke-width="2" stroke-linecap="round"/>
            <polygon points="60,0 64,4 60,8 56,4" fill="#F4B63F" stroke="#FFF6E5" stroke-width="0.6"/>
          </svg>
        </div>

        <p class="hero-lead">
          {lead}
        </p>

        <!-- CTA Principal: Pequena Placa Pintada em Barco Amazônico -->
        <div class="hero-actions">
          <a href={ctaLink} class="hero-boat-plate-btn" aria-label="Explorar histórias e saberes do Pará">
            <span class="plate-text">{ctaText}</span>
            <span class="plate-arrow" aria-hidden="true">
              <i class="fa-solid fa-arrow-down"></i>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     Editorial Hero — Imagem Nítida e Placa Náutica dos Barcos
     ============================================================ */
  .editorial-hero {
    position: relative;
    width: 100%;
    margin-bottom: var(--space-12);
    padding: 0;
    overflow: hidden;
  }

  .hero-frame {
    position: relative;
    width: 100%;
    min-height: clamp(560px, 80vh, 820px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--color-cult-navy-deep);
    overflow: hidden;
  }

  /* Imagem Principal Nítida e Completa, sem cortes excessivos */
  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: contrast(1.08) saturate(1.18) brightness(1.02);
    transform: scale(1.0);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-frame:hover .hero-media {
    transform: scale(1.01);
  }

  /* Scrim 100% Limpo na Base: zero sombreado na parte inferior para mostrar a foto por completo */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(7, 13, 34, 0.45) 0%,
      rgba(7, 13, 34, 0.15) 35%,
      transparent 65%
    );
    pointer-events: none;
  }

  /* Conteúdo Editorial Posicionado para Ótima Leitura */
  .hero-content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
    display: flex;
    align-items: center;
  }

  .hero-text-content {
    max-width: 740px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: var(--space-4);
  }

  /* Filete Ornamental Superior dos Abridores de Letras */
  .hero-fluvial-ornament {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .filete-wing {
    display: inline-block;
    width: 38px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #F4B63F);
  }

  .filete-wing--right {
    background: linear-gradient(90deg, #F4B63F, transparent);
  }

  .filete-star {
    flex-shrink: 0;
  }

  /* Headline Dominante e Expressiva */
  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.8vw, 3.8rem);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0;
    text-shadow:
      0 2px 6px rgba(7, 13, 34, 0.95),
      0 8px 24px rgba(7, 13, 34, 0.9);
  }

  /* Linha das Águas Fluviais */
  .hero-river-line {
    display: flex;
    align-items: center;
    margin-top: calc(-1 * var(--space-1));
  }

  /* Descrição Editorial Fluida */
  .hero-lead {
    font-family: var(--font-sans);
    font-size: clamp(1.02rem, 1.35vw, 1.22rem);
    line-height: 1.65;
    color: var(--color-cult-cream);
    max-width: 660px;
    margin: 0;
    font-weight: 400;
    text-shadow:
      0 2px 8px rgba(7, 13, 34, 0.9),
      0 4px 16px rgba(7, 13, 34, 0.85);
  }

  /* Ações / Botão */
  .hero-actions {
    display: flex;
    align-items: center;
    margin-top: var(--space-4);
  }

  /* ============================================================
     CTA Principal: Placa Pintada em Barco Amazônico
     - fundo: #F4B63F
     - texto: #070D22
     - border: 2px solid #FFF6E5
     - box-shadow: 5px 5px 0 #17A9B8
     - cantos levemente chanfrados
     - peso tipográfico forte
     - no hover: deslocar 2px baixo/direita, reduzir sombra, transição 180-220ms
     ============================================================ */
  .hero-boat-plate-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 0.95rem 2.2rem;
    background-color: var(--color-cult-gold);
    color: var(--color-cult-navy-deep);
    border: 2px solid var(--color-cult-cream);
    box-shadow: 5px 5px 0 var(--color-cult-turquoise);
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition:
      transform 200ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 200ms cubic-bezier(0.2, 0, 0, 1),
      filter 200ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* Filete Interno de Placa Pintada à Mão */
  .hero-boat-plate-btn::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(7, 13, 34, 0.35);
    border-radius: 2px;
    pointer-events: none;
  }

  /* Efeito Hover dos Abridores de Letras (Deslocamento Físico de 2px e Redução de Sombra) */
  .hero-boat-plate-btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--color-cult-turquoise);
    filter: saturate(1.18);
  }

  .hero-boat-plate-btn:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 var(--color-cult-turquoise);
  }

  .plate-text {
    line-height: 1;
  }

  .plate-arrow {
    font-size: 0.9rem;
    line-height: 1;
    transition: transform var(--transition-fast);
  }

  .hero-boat-plate-btn:hover .plate-arrow {
    transform: translateY(2px);
  }

  /* ============================================================
     Responsividade
     ============================================================ */
  @media (max-width: 900px) {
    .hero-frame {
      min-height: 560px;
      justify-content: center;
    }

    .hero-content-wrapper {
      padding: var(--space-8) var(--space-4);
      justify-content: center;
    }

    .hero-text-content {
      align-items: center;
      text-align: center;
    }

    .hero-headline {
      font-size: clamp(2rem, 5.5vw, 3rem);
    }

    .hero-scrim {
      background: radial-gradient(
        ellipse 90% 55% at 50% 35%,
        rgba(7, 13, 34, 0.50) 0%,
        rgba(7, 13, 34, 0.20) 45%,
        transparent 75%
      );
    }
  }

  @media (max-width: 640px) {
    .editorial-hero {
      margin-bottom: var(--space-8);
    }

    .hero-frame {
      min-height: 500px;
    }

    .hero-media {
      object-position: center center;
    }

    .hero-content-wrapper {
      padding: var(--space-6) var(--space-3);
    }

    .hero-headline {
      font-size: 1.85rem;
      line-height: 1.2;
    }

    .hero-lead {
      font-size: 0.96rem;
      line-height: 1.55;
    }

    .hero-boat-plate-btn {
      width: 100%;
      max-width: 300px;
      padding: 0.85rem 1.6rem;
      font-size: 0.95rem;
    }
  }
</style>
