---
// src/components/TerritoryFilter.astro
interface Props {
  currentTerritory?: string;
  currentCategory?: string;
}

const { currentTerritory, currentCategory } = Astro.props;

const territories = [
  { id: 'all', label: 'Todo o Acervo', icon: '✦' },
  { id: 'para', label: 'Cultura Paraense & Belém', icon: '🛶' },
  { id: 'nacional', label: 'Arte Nacional', icon: '🇧🇷' },
  { id: 'global', label: 'Mundo & Clássicos', icon: '🌍' }
];

function buildUrl(territoryId: string) {
  const params = new URLSearchParams();
  if (territoryId !== 'all') {
    params.set('territorio', territoryId);
  }
  if (currentCategory) {
    params.set('categoria', currentCategory);
  }
  const qs = params.toString();
  return qs ? `/?${qs}` : '/';
}
---

<div class="territory-filter">
  <div class="filter-header">
    <span class="filter-label">Filtro por Escopo Cultural:</span>
  </div>

  <div class="tabs-container">
    {territories.map((t) => {
      const isActive = (currentTerritory === t.id) || (!currentTerritory && t.id === 'all');
      return (
        <a
          href={buildUrl(t.id)}
          class={`tab-button ${isActive ? 'active' : ''} ${t.id === 'para' ? 'tab-para' : ''}`}
        >
          <span class="tab-icon">{t.icon}</span>
          <span class="tab-text">{t.label}</span>
        </a>
      );
    })}
  </div>
</div>

<style>
  .territory-filter {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .filter-header {
    display: flex;
    align-items: center;
  }

  .filter-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  .tabs-container {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    background-color: var(--color-surface);
    padding: 0.35rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .tab-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .tab-button:hover {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .tab-button.active {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }

  .tab-button.tab-para.active {
    border-color: var(--color-orange-hibiscus);
    color: var(--color-beniukon-bronze);
  }

  .tab-icon {
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .tabs-container {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.5rem;
    }
    .tab-button {
      white-space: nowrap;
    }
  }
</style>
