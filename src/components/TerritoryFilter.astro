---
// src/components/TerritoryFilter.astro
interface Props {
  currentTerritory?: string;
  currentCategory?: string;
}

const { currentTerritory, currentCategory } = Astro.props;

const territories = [
  { id: 'all', label: 'Todo o Acervo', icon: 'fa-solid fa-layer-group' },
  { id: 'para', label: 'Cultura Paraense & Belém', icon: 'fa-solid fa-water' },
  { id: 'nacional', label: 'Arte Nacional', icon: 'fa-solid fa-landmark' },
  { id: 'global', label: 'Mundo & Clássicos', icon: 'fa-solid fa-earth-americas' }
];

function buildUrl(territoryId: string) {
  const params = new URLSearchParams();
  if (territoryId !== 'all') {
    params.set('territorio', territoryId);
  }
  if (currentCategory) {
    params.set('categoria', currentCategory);
  }
  const qs = params.toString();
  return qs ? `/?${qs}#todas-historias` : '/#todas-historias';
}
---

<div class="territory-filter-bar">
  <div class="filter-lead">
    <span class="filter-label">Escopo Territorial:</span>
  </div>

  <nav class="territory-pills" aria-label="Filtrar ensaios por território">
    {territories.map((t) => {
      const isActive = (currentTerritory === t.id) || (!currentTerritory && t.id === 'all');
      return (
        <a
          href={buildUrl(t.id)}
          class={`territory-pill ${isActive ? 'active' : ''} ${t.id === 'para' ? 'pill-para' : ''}`}
          aria-current={isActive ? 'true' : undefined}
        >
          <i class={`pill-icon ${t.icon}`} aria-hidden="true"></i>
          <span>{t.label}</span>
        </a>
      );
    })}
  </nav>
</div>

<style>
  .territory-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-cult-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .filter-lead {
    display: flex;
    align-items: center;
  }

  .filter-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-cult-text-dim);
  }

  .territory-pills {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .territory-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-cult-text-muted);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .territory-pill:hover {
    color: var(--color-cult-text);
    background-color: var(--color-cult-surface-hover);
  }

  .territory-pill.active {
    background-color: var(--color-cult-surface-raised);
    color: var(--color-cult-text);
    border-color: var(--color-border-strong);
    font-weight: 600;
  }

  .territory-pill.pill-para.active {
    border-color: var(--color-cult-turquoise);
    color: var(--color-cult-turquoise);
  }

  .pill-icon {
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .territory-filter-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .territory-pills {
      overflow-x: auto;
      flex-wrap: nowrap;
      width: 100%;
      padding-bottom: 0.2rem;
    }

    .territory-pill {
      white-space: nowrap;
    }
  }
</style>
