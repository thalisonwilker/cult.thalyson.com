---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';
import CultLogo from './CultLogo.astro';

interface Props {
  currentCategory?: string;
}

const { currentCategory } = Astro.props;

const categories = [
  { slug: 'musica', label: 'Música', accent: 'var(--color-cult-gold)' },
  { slug: 'patrimonio', label: 'Patrimônio', accent: 'var(--color-cult-coral)' },
  { slug: 'cinema', label: 'Cinema', accent: 'var(--color-cult-orange)' },
  { slug: 'literatura', label: 'Literatura', accent: 'var(--color-cult-turquoise)' },
  { slug: 'artes', label: 'Artes', accent: 'var(--color-cult-cobalt)' }
];
---

<header class="editorial-header">
  <div class="header-inner">
    <!-- Unidade de Marca: Nova Logo Fluvial dos Abridores de Letras -->
    <div class="brand-unit">
      <CultLogo variant="header" />
    </div>

    <!-- Navegação Editorial Desktop em Linha Única à Direita -->
    <nav class="editorial-nav-desktop" aria-label="Navegação editorial principal">
      <ul class="nav-list">
        {categories.map((cat) => {
          const isActive = currentCategory === cat.slug;
          return (
            <li class="nav-item">
              <a
                href={`/?categoria=${cat.slug}`}
                class={`editorial-link ${isActive ? 'active' : ''}`}
                style={`--nav-accent: ${cat.accent};`}
                aria-current={isActive ? 'page' : undefined}
              >
                <span class="accent-dot" aria-hidden="true"></span>
                <span class="link-label">{cat.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Ações: Theme Switcher & Menu Hambúrguer Mobile -->
    <div class="header-actions">
      <ThemeToggle />

      <button
        id="mobile-menu-trigger"
        class="mobile-menu-btn"
        type="button"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Assinatura Visual Discreta da Revista -->
  <div class="signature-bar" aria-hidden="true"></div>

  <!-- Mobile Drawer / Overlay Acessível -->
  <div id="mobile-nav-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <div class="drawer-content" role="dialog" aria-modal="true" aria-label="Menu de Categorias">
      <div class="drawer-header">
        <CultLogo variant="compact" />
        <button
          id="mobile-menu-close"
          class="drawer-close-btn"
          type="button"
          aria-label="Fechar menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="drawer-nav" aria-label="Navegação mobile">
        <ul class="drawer-list">
          <li>
            <a href="/" class={`drawer-link ${!currentCategory ? 'active' : ''}`}>
              <span class="drawer-dot" style="background-color: var(--color-cult-turquoise);"></span>
              <span>Todo o Acervo</span>
            </a>
          </li>
          {categories.map((cat) => {
            const isActive = currentCategory === cat.slug;
            return (
              <li>
                <a
                  href={`/?categoria=${cat.slug}`}
                  class={`drawer-link ${isActive ? 'active' : ''}`}
                >
                  <span class="drawer-dot" style={`background-color: ${cat.accent};`}></span>
                  <span>{cat.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="drawer-footer">
        <p class="drawer-caption">
          Um portal crítico e afetivo sobre as artes, memórias e saberes da Amazônia Atlântica.
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  /* ============================================================
     Header Editorial Shell
     ============================================================ */
  .editorial-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-header-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .editorial-header.is-scrolled {
    background-color: rgba(7, 13, 34, 0.94);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .header-inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: var(--space-2) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    transition: padding 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-header.is-scrolled .header-inner {
    padding: var(--space-1) var(--space-6);
  }

  /* ============================================================
     Unidade de Marca (Nova Logo Fluvial)
     ============================================================ */
  .brand-unit {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* ============================================================
     Navegação Editorial Desktop (Linha Única à Direita)
     ============================================================ */
  .editorial-nav-desktop {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: flex-end;
    margin-right: var(--space-4);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: inline-flex;
  }

  .editorial-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--color-cult-text-muted);
    text-decoration: none;
    padding: var(--space-2) var(--space-2);
    position: relative;
    transition: color var(--transition-fast);
  }

  .accent-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--nav-accent);
    opacity: 0.4;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .link-label {
    letter-spacing: 0.01em;
  }

  .editorial-link:hover {
    color: var(--color-cult-text);
  }

  .editorial-link:hover .accent-dot {
    opacity: 1;
    transform: scale(1.3);
  }

  .editorial-link.active {
    color: var(--color-cult-text);
    font-weight: 600;
  }

  .editorial-link.active .accent-dot {
    opacity: 1;
    transform: scale(1.4);
    box-shadow: 0 0 8px var(--nav-accent);
  }

  /* ============================================================
     Ações do Header
     ============================================================ */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    cursor: pointer;
    color: var(--color-cult-text);
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 38px;
    height: 38px;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  /* ============================================================
     Mobile Drawer / Overlay Acessível
     ============================================================ */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
  }

  .mobile-drawer.open {
    display: block;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(3, 7, 18, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 85vw);
    background-color: var(--color-cult-surface-raised);
    border-left: 1px solid var(--color-border-strong);
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
    animation: slideInRight var(--transition-normal);
  }

  @keyframes slideInRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .drawer-brand {
    display: flex;
    flex-direction: column;
  }

  .brand-tagline-mobile {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-cult-text-muted);
  }

  .drawer-close-btn {
    background: transparent;
    border: none;
    color: var(--color-cult-text-muted);
    cursor: pointer;
    padding: var(--space-1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
  }

  .drawer-close-btn:hover {
    color: var(--color-cult-text);
  }

  .drawer-nav {
    flex: 1;
  }

  .drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-cult-text-muted);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .drawer-link:hover,
  .drawer-link.active {
    color: var(--color-cult-text);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .drawer-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
  }

  .drawer-footer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .drawer-caption {
    font-size: 0.8rem;
    color: var(--color-cult-text-dim);
    line-height: 1.5;
  }

  /* ============================================================
     Responsividade
     ============================================================ */
  @media (max-width: 960px) {
    .nav-list {
      gap: var(--space-4);
    }
  }

  @media (max-width: 860px) {
    .editorial-nav-desktop {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .header-inner {
      padding: var(--space-3) var(--space-4);
    }
  }
</style>

<script is:inline>
  const menuTrigger = document.getElementById('mobile-menu-trigger');
  const menuClose = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-nav-drawer');
  const backdrop = document.getElementById('drawer-backdrop');

  function openMenu() {
    if (drawer && menuTrigger) {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      menuTrigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      if (menuClose) menuClose.focus();
    }
  }

  function closeMenu() {
    if (drawer && menuTrigger) {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      menuTrigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      menuTrigger.focus();
    }
  }

  if (menuTrigger) {
    menuTrigger.addEventListener('click', openMenu);
  }

  if (menuClose) {
    menuClose.addEventListener('click', closeMenu);
  }

  if (backdrop) {
    backdrop.addEventListener('click', closeMenu);
  }

  // Teclado acessível: fechar com Escape
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) {
      closeMenu();
    }
  });

  // Efeito de encolhimento da navbar e da logo durante a navegação/scroll
  const siteHeader = document.querySelector('.editorial-header');
  let scrollTicking = false;

  function updateHeaderScroll() {
    if (siteHeader) {
      if (window.scrollY > 25) {
        siteHeader.classList.add('is-scrolled');
      } else {
        siteHeader.classList.remove('is-scrolled');
      }
    }
    scrollTicking = false;
  }

  window.addEventListener('scroll', () => {
    if (!scrollTicking) {
      window.requestAnimationFrame(updateHeaderScroll);
      scrollTicking = true;
    }
  }, { passive: true });

  updateHeaderScroll();
</script>
