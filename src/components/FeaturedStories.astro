---
// src/components/FeaturedStories.astro
import type { CollectionEntry } from 'astro:content';
import { calculateReadingTime, formatDate } from '../domain/reading-time';
import { getEssayUrl } from '../domain/routes';

interface Props {
  stories?: CollectionEntry<'ensaios'>[];
  featured?: CollectionEntry<'ensaios'>;
  secondary?: CollectionEntry<'ensaios'>[];
}

const { stories, featured, secondary = [] } = Astro.props;

// Normaliza a lista de destaques (máximo 3 itens)
const items: CollectionEntry<'ensaios'>[] = (
  stories && stories.length > 0
    ? stories
    : [featured, ...secondary].filter(Boolean) as CollectionEntry<'ensaios'>[]
).slice(0, 3);

---

{items.length > 0 && (
  <section id="em-destaque" class="featured-section" aria-label="Histórias em Destaque">
    <div class="section-header-editorial">
      <div class="header-title-wrap">
        <h2 class="section-title-editorial">Em Destaque</h2>
      </div>
    </div>

    <div class="featured-grid">
      {items.map((story) => {
        const storyUrl = getEssayUrl(story.data.category, story.slug);
        return (
          <article class="featured-story-card">
            <a href={storyUrl} class="card-media-link" tabindex="-1" aria-hidden="true">
              <div class="card-img-frame">
                <img
                  src={story.data.coverImage || '/images/carimbo-guitarrada-noite.jpg'}
                  alt={`Capa do ensaio: ${story.data.title}`}
                  class="card-img"
                  loading="lazy"
                  style={story.data.coverImagePosition ? `object-position: ${story.data.coverImagePosition};` : undefined}
                />
                <div class="card-media-overlay" aria-hidden="true"></div>
              </div>
            </a>

            <div class="card-content">
              <div class="meta-row">
                {story.data.locality && (
                  <span class="badge-locality">
                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                    {story.data.locality}
                  </span>
                )}
                {story.data.locality && <span class="meta-bullet" aria-hidden="true">·</span>}
                <span class="reading-time">
                  <i class="fa-regular fa-clock" aria-hidden="true"></i>
                  {calculateReadingTime(story.body)} min de leitura
                </span>
              </div>

              <h3 class="card-title">
                <a href={storyUrl} class="title-link">
                  {story.data.title}
                </a>
              </h3>

              <p class="card-description">
                {story.data.description}
              </p>

              <div class="card-footer">
                <span class="story-date">{formatDate(story.data.pubDate)}</span>
                <a href={storyUrl} class="read-more-link">
                  <span>Ler ensaio</span>
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
)}

<style>
  /* ============================================================
     Featured Stories Section — Grade de 3 Itens Compactos
     ============================================================ */
  .featured-section {
    margin-bottom: var(--space-16);
  }

  .header-title-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .section-tag-editorial {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-cult-turquoise);
  }

  .section-title-editorial {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 2.8vw, 2.4rem);
    font-weight: 700;
    color: var(--color-cult-text);
    margin: 0;
  }

  .section-header-editorial {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-cult-border);
  }

  /* Grid de 3 colunas iguais no desktop — cada card ocupa 1/3 */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: stretch;
  }

  /* Cada card tem proporção compacta e peso uniforme */
  .featured-story-card {
    background-color: var(--color-cult-surface);
    border: 1px solid var(--color-cult-border);
    border-bottom: 3px solid var(--color-cult-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .featured-story-card:hover {
    transform: translate(-2px, -2px);
    border-color: var(--color-cult-border-strong);
    border-bottom-color: var(--color-cult-coral);
    box-shadow: 4px 4px 0 #EC5B5B;
  }

  .card-media-link {
    display: block;
    overflow: hidden;
  }

  .card-img-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 190px;
    overflow: hidden;
    background-color: var(--color-cult-surface-raised);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .featured-story-card:hover .card-img {
    transform: scale(1.035);
  }

  .card-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 13, 34, 0.1) 0%, rgba(7, 13, 34, 0.6) 100%);
    pointer-events: none;
  }

  .category-pill-overlay {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    background-color: rgba(7, 13, 34, 0.88);
    border: 1px solid var(--cat-color);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .card-content {
    padding: var(--space-4) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: 0.76rem;
    color: var(--color-cult-text-dim);
  }

  .badge-locality {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-cult-turquoise);
    font-weight: 500;
  }

  .meta-bullet {
    color: var(--color-cult-border-strong);
  }

  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.35vw, 1.28rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 var(--space-2) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .title-link {
    color: var(--color-cult-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .title-link:hover {
    color: var(--color-cult-coral);
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-cult-text-muted);
    margin: 0 0 var(--space-3) 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.78rem;
    margin-top: auto;
  }

  .story-date {
    color: var(--color-cult-text-dim);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-cult-turquoise);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .read-more-link:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  /* Responsividade */
  @media (max-width: 1023px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (max-width: 639px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
