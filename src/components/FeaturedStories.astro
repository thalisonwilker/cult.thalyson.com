---
// src/components/FeaturedStories.astro
import type { CollectionEntry } from 'astro:content';
import { calculateReadingTime, formatDate } from '../domain/reading-time';

interface Props {
  featured: CollectionEntry<'ensaios'>;
  secondary: CollectionEntry<'ensaios'>[];
}

const { featured, secondary } = Astro.props;

const categoryColors: Record<string, string> = {
  musica: 'var(--color-cult-gold)',
  patrimonio: 'var(--color-cult-coral)',
  cinema: 'var(--color-cult-orange)',
  literatura: 'var(--color-cult-turquoise)',
  artes: 'var(--color-cult-cobalt)',
  ensaios: 'var(--color-cult-turquoise)',
  gastronomia: 'var(--color-cult-orange)'
};

const categoryNames: Record<string, string> = {
  musica: 'Música',
  patrimonio: 'Patrimônio',
  cinema: 'Cinema',
  literatura: 'Literatura',
  artes: 'Artes',
  ensaios: 'Ensaios',
  gastronomia: 'Gastronomia'
};
---

<section id="em-destaque" class="featured-section" aria-label="Histórias em Destaque">
  <div class="section-header-editorial">
    <div class="header-title-wrap">
      <span class="section-tag-editorial">Histórias do Pará</span>
      <h2 class="section-title-editorial">Em Destaque</h2>
    </div>
  </div>

  <div class="featured-grid">
    <!-- Coluna Principal (2fr) -->
    {featured && (
      <article class="primary-story-card">
        <a href={`/ensaios/${featured.slug}`} class="primary-media-link" tabindex="-1" aria-hidden="true">
          <div class="primary-img-frame">
            <img
              src={featured.data.coverImage || '/images/carimbo-guitarrada-noite.jpg'}
              alt={`Capa do ensaio: ${featured.data.title}`}
              class="primary-img"
              loading="lazy"
              style={featured.data.coverImagePosition ? `object-position: ${featured.data.coverImagePosition};` : undefined}
            />
            <div class="media-overlay" aria-hidden="true"></div>
            <span
              class="category-pill-overlay"
              style={`--cat-color: ${categoryColors[featured.data.category] || 'var(--color-cult-turquoise)'};`}
            >
              {categoryNames[featured.data.category] || featured.data.category}
            </span>
          </div>
        </a>

        <div class="primary-content">
          <div class="meta-row">
            {featured.data.locality && (
              <span class="badge-locality">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                {featured.data.locality}
              </span>
            )}
            <span class="meta-bullet" aria-hidden="true">·</span>
            <span class="reading-time">
              {calculateReadingTime(featured.body)} min de leitura
            </span>
          </div>

          <h3 class="primary-title">
            <a href={`/ensaios/${featured.slug}`} class="title-link">
              {featured.data.title}
            </a>
          </h3>

          <p class="primary-description">
            {featured.data.description}
          </p>

          <div class="primary-footer">
            <span class="story-date">{formatDate(featured.data.pubDate)}</span>
            <a href={`/ensaios/${featured.slug}`} class="read-more-link">
              <span>Ler ensaio completo</span>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </article>
    )}

    <!-- Coluna Secundária (1fr) — Lista Editorial -->
    <div class="secondary-stories-column">
      {secondary.map((story) => {
        const catColor = categoryColors[story.data.category] || 'var(--color-cult-turquoise)';
        return (
          <article class="secondary-story-card">
            <a href={`/ensaios/${story.slug}`} class="secondary-thumb-link" tabindex="-1" aria-hidden="true">
              <div class="secondary-thumb-frame">
                <img
                  src={story.data.coverImage || '/images/belem-noite-estrelada.jpg'}
                  alt={`Miniatura de ${story.data.title}`}
                  class="secondary-thumb"
                  loading="lazy"
                  style={story.data.coverImagePosition ? `object-position: ${story.data.coverImagePosition};` : undefined}
                />
              </div>
            </a>

            <div class="secondary-content">
              <div class="secondary-meta">
                <span class="secondary-cat" style={`--cat-color: ${catColor};`}>
                  {categoryNames[story.data.category] || story.data.category}
                </span>
                {story.data.locality && (
                  <span class="secondary-loc">· {story.data.locality}</span>
                )}
              </div>

              <h4 class="secondary-title">
                <a href={`/ensaios/${story.slug}`} class="secondary-title-link">
                  {story.data.title}
                </a>
              </h4>

              <div class="secondary-footer">
                <span class="secondary-time">
                  <i class="fa-regular fa-clock" aria-hidden="true"></i>
                  {calculateReadingTime(story.body)} min
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* ============================================================
     Featured Stories Section
     ============================================================ */
  .featured-section {
    margin-bottom: var(--space-24);
  }

  .header-title-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .section-note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-cult-text-dim);
  }

  /* Grid 2fr / 1fr */
  .featured-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: var(--space-8);
    align-items: stretch;
  }

  /* ============================================================
     Card Primário (2fr)
     ============================================================ */
  .primary-story-card {
    background-color: var(--color-cult-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .primary-story-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .primary-media-link {
    display: block;
    overflow: hidden;
  }

  .primary-img-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-cult-surface-raised);
  }

  .primary-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .primary-story-card:hover .primary-img {
    transform: scale(1.025);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: var(--gradient-card-overlay);
    opacity: 0.7;
    pointer-events: none;
  }

  .category-pill-overlay {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    background-color: rgba(7, 13, 34, 0.85);
    border: 1px solid var(--cat-color);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .primary-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: 0.8rem;
    color: var(--color-cult-text-dim);
  }

  .meta-bullet {
    color: var(--color-cult-border-strong);
  }

  .primary-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: var(--space-3);
  }

  .title-link {
    color: var(--color-cult-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .title-link:hover {
    color: var(--color-cult-coral);
  }

  .primary-description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-cult-text-muted);
    margin-bottom: var(--space-6);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .primary-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-cult-text-dim);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--color-cult-turquoise);
    text-decoration: none;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .read-more-link:hover {
    color: var(--color-cult-text);
    gap: 0.6rem;
  }

  /* ============================================================
     Coluna Secundária (1fr)
     ============================================================ */
  .secondary-stories-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .secondary-story-card {
    background-color: var(--color-cult-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--space-4);
    align-items: center;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .secondary-story-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    background-color: var(--color-cult-surface-hover);
  }

  .secondary-thumb-link {
    display: block;
  }

  .secondary-thumb-frame {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-cult-surface-raised);
  }

  .secondary-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .secondary-story-card:hover .secondary-thumb {
    transform: scale(1.05);
  }

  .secondary-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .secondary-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .secondary-cat {
    color: var(--cat-color);
  }

  .secondary-loc {
    color: var(--color-cult-text-dim);
    font-weight: 400;
  }

  .secondary-title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }

  .secondary-title-link {
    color: var(--color-cult-text);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .secondary-title-link:hover {
    color: var(--color-cult-coral);
  }

  .secondary-footer {
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    color: var(--color-cult-text-dim);
    margin-top: 0.2rem;
  }

  .secondary-time {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* ============================================================
     Responsividade
     ============================================================ */
  @media (max-width: 960px) {
    .featured-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 540px) {
    .secondary-story-card {
      grid-template-columns: 80px 1fr;
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .secondary-thumb-frame {
      width: 80px;
      height: 80px;
    }

    .primary-content {
      padding: var(--space-4);
    }
  }
</style>
