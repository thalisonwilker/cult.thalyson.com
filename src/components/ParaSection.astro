---
// src/components/ParaSection.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  paraEssays?: CollectionEntry<'ensaios'>[];
}

const { paraEssays: _paraEssays = [] } = Astro.props;

const pillars = [
  {
    title: 'Carimbó Chamegado & Resistência',
    subtitle: 'O balanço dos tambores curimbó e o encanto poético de Dona Onete.',
    tag: 'Música Tradicional',
    color: 'var(--color-cult-gold)',
    icon: 'fa-solid fa-drum',
    link: '/?categoria=musica'
  },
  {
    title: 'Guitarrada Elétrica das Marés',
    subtitle: 'As notas inventivas de Mestre Vieira que fundiram o choro e o merengue.',
    tag: 'Instrumental Caboclo',
    color: 'var(--color-cult-orange)',
    icon: 'fa-solid fa-guitar',
    link: '/?categoria=musica'
  },
  {
    title: 'O Círio & A Fé das Águas',
    subtitle: 'A comunhão de dois milhões de vozes sob os túneis de mangueiras de Belém.',
    tag: 'Patrimônio Imaterial',
    color: 'var(--color-cult-coral)',
    icon: 'fa-solid fa-hands-praying',
    link: '/patrimonio/as-14-procissoes-do-cirio-de-nazare/'
  },
  {
    title: 'Abridores de Letras Fluviais',
    subtitle: 'A tipografia vernacular pintada nos cascos de madeira que cruzam os rios.',
    tag: 'Artes Visuais & Design',
    color: 'var(--color-cult-turquoise)',
    icon: 'fa-solid fa-paintbrush',
    link: '/?categoria=artes'
  }
];
---

<section class="belem-para-section" aria-label="Especial Belém e Pará">
  <div class="section-header-editorial">
    <div class="header-title-wrap">
      <span class="section-tag-editorial">
        <i class="fa-solid fa-anchor" aria-hidden="true"></i> Território &amp; Identidade
      </span>
      <h2 class="section-title-editorial">Belém &amp; Pará</h2>
    </div>
  </div>

  <div class="para-editorial-container">
    <!-- Banner de Contexto Editorial -->
    <div class="para-feature-banner">
      <div class="banner-backdrop-frame">
        <img
          src="/images/belem-noite-estrelada.jpg"
          alt="Obra artística da Baía do Guajará em Belém do Pará à noite"
          class="banner-bg-img"
          loading="lazy"
        />
        <div class="banner-gradient-overlay" aria-hidden="true"></div>
      </div>

      <div class="banner-editorial-body">
        <div class="location-pill">
          <i class="fa-solid fa-water" aria-hidden="true"></i>
          <span>Amazônia Atlântica · Foz do Amazonas</span>
        </div>
        <h3 class="banner-headline">
          Da cerâmica milenar do Marajó às luzes hipnóticas das aparelhagens
        </h3>
        <p class="banner-text">
          Belém é uma metrópole ribeirinha onde a floresta e o concreto respiram a mesma umidade.
          Aqui, o sagrado e a festa popular não competem: dividem a mesa no tacacá, ecoam nos tambores de São Benedito
          e viajam nas proas coloridas dos barcos que singram a Baía do Guajará.
        </p>
      </div>
    </div>

    <!-- Grade dos 4 Pilares da Cultura Paraense -->
    <div class="pillars-grid">
      {pillars.map((pillar) => (
        <a
          href={pillar.link}
          class="pillar-editorial-card"
          style={`--pillar-color: ${pillar.color};`}
        >
          <div class="pillar-top-row">
            <span class="pillar-tag">{pillar.tag}</span>
            <i class={`pillar-icon ${pillar.icon}`} aria-hidden="true"></i>
          </div>
          <h4 class="pillar-title">{pillar.title}</h4>
          <p class="pillar-subtitle">{pillar.subtitle}</p>
          <span class="pillar-cta">
            <span>Explorar ensaio</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ============================================================
     Belém & Pará Section
     ============================================================ */
  .belem-para-section {
    margin-bottom: var(--space-24);
  }

  .header-title-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .view-all-para-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-cult-turquoise);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .view-all-para-link:hover {
    color: var(--color-cult-text);
    gap: 0.55rem;
  }

  .para-editorial-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Banner Editorial Panorâmico */
  .para-feature-banner {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-cult-surface);
    box-shadow: var(--shadow-md);
  }

  .banner-backdrop-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .banner-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: brightness(0.8);
  }

  .banner-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(7, 13, 34, 0.95) 0%,
      rgba(7, 13, 34, 0.85) 55%,
      rgba(7, 13, 34, 0.4) 100%
    );
  }

  .banner-editorial-body {
    position: relative;
    z-index: 2;
    padding: var(--space-8) var(--space-8);
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-cult-turquoise);
    background-color: rgba(7, 13, 34, 0.65);
    border: 1px solid rgba(23, 169, 184, 0.35);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .banner-headline {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .banner-text {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.65;
    color: #D6DFEE;
  }

  /* Grade dos 4 Pilares */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .pillar-editorial-card {
    background-color: var(--color-cult-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .pillar-editorial-card:hover {
    transform: translate(-2px, -2px);
    border-color: var(--pillar-color);
    border-bottom: 3px solid var(--pillar-color);
    box-shadow: 4px 4px 0 var(--pillar-color);
    background-color: var(--color-cult-surface-hover);
  }

  .pillar-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .pillar-tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pillar-color);
  }

  .pillar-icon {
    font-size: 1rem;
    color: var(--pillar-color);
    opacity: 0.9;
  }

  .pillar-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-cult-text);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .pillar-subtitle {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-cult-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .pillar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--pillar-color);
    margin-top: auto;
    transition: gap var(--transition-fast);
  }

  .pillar-editorial-card:hover .pillar-cta {
    gap: 0.55rem;
  }

  @media (max-width: 768px) {
    .banner-editorial-body {
      padding: var(--space-6) var(--space-4);
    }

    .banner-gradient-overlay {
      background: linear-gradient(
        180deg,
        rgba(7, 13, 34, 0.7) 0%,
        rgba(7, 13, 34, 0.95) 100%
      );
    }

    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
