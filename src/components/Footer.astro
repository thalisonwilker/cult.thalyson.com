---
// src/components/Footer.astro
import CultLogo from './CultLogo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="signature-bar" aria-hidden="true"></div>

  <div class="footer-container">
    <!-- Destaque Central da Marca Fluvial no Rodapé -->
    <div class="footer-brand-spotlight">
      <div class="footer-brand-center">
        <CultLogo variant="footer" />
      </div>
      <p class="manifesto-text-center">
        Espaço pessoal para compartilhar a memória viva, os saberes caboclos, a música, literatura e artes visuais de Belém e da Amazônia Atlântica.
      </p>
    </div>

    <!-- Navegação Editorial do Rodapé Centralizada -->
    <div class="footer-nav-columns">
      <div class="nav-col">
        <span class="col-title">Vertentes</span>
        <ul class="col-links">
          <li><a href="/?categoria=musica">Música &amp; Ritmos</a></li>
          <li><a href="/?categoria=patrimonio">Círio &amp; Patrimônio</a></li>
          <li><a href="/?categoria=cinema">Cinema</a></li>
          <li><a href="/?categoria=literatura">Literatura</a></li>
          <li><a href="/?categoria=artes">Artes Visuais</a></li>
        </ul>
      </div>

      <div class="nav-col">
        <span class="col-title">Territórios</span>
        <ul class="col-links">
          <li><a href="/?territorio=para">Belém &amp; Pará</a></li>
          <li><a href="/?territorio=nacional">Arte Nacional</a></li>
          <li><a href="/?territorio=global">Mundo &amp; Clássicos</a></li>
        </ul>
      </div>
    </div>

    <!-- Filete Ornamental Fluvial como Assinatura Final -->
    <div class="footer-final-filete" aria-hidden="true">
      <span class="filete-line"></span>
      <svg width="48" height="14" viewBox="0 0 48 14" fill="none">
        <path d="M0 7 H16 M32 7 H48" stroke="#17A9B8" stroke-width="1.5" stroke-linecap="round"/>
        <polygon points="24,1 28,7 24,13 20,7" fill="#F4B63F" stroke="#FFF6E5" stroke-width="0.8"/>
        <circle cx="16" cy="7" r="1.5" fill="#EC5B5B"/>
        <circle cx="32" cy="7" r="1.5" fill="#EC5B5B"/>
      </svg>
      <span class="filete-line"></span>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {year} <strong>CULT.thalyson.com</strong> — Compartilhando a cultura, a música e as histórias do Pará por Thalyson.
      </p>
      <div class="footer-extra-links">
        {import.meta.env.DEV && (
          <a href="/admin/" class="dev-admin-link" title="Acessar Painel Administrativo Local">
            Painel Admin [DEV]
          </a>
        )}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-cult-surface);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
    position: relative;
    transition: background-color var(--transition-normal);
  }

  .footer-container {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* ============================================================
     Destaque Central da Marca Fluvial no Rodapé
     ============================================================ */
  .footer-brand-spotlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
  }

  .footer-brand-center {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: var(--space-1);
  }

  /* Halo sutil de iluminação fluvial destacando a logo */
  .footer-brand-center::before {
    content: '';
    position: absolute;
    width: 280px;
    height: 120px;
    background: radial-gradient(ellipse at center, rgba(244, 182, 63, 0.22) 0%, rgba(23, 169, 184, 0.14) 50%, transparent 75%);
    filter: blur(20px);
    z-index: 0;
    pointer-events: none;
  }

  .manifesto-text-center {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-cult-text-muted);
    line-height: 1.68;
    max-width: 580px;
    margin: 0 auto;
    text-align: center;
  }

  /* Navegação em Colunas Centralizadas */
  .footer-nav-columns {
    display: flex;
    justify-content: center;
    gap: var(--space-16);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }

  .nav-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .col-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-cult-turquoise);
  }

  .col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .col-links a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-cult-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .col-links a:hover {
    color: var(--color-cult-text);
  }

  /* Filete Ornamental de Assinatura Final */
  .footer-final-filete {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    opacity: 0.9;
  }

  .footer-final-filete .filete-line {
    flex: 1;
    max-width: 120px;
    height: 1.5px;
    background: linear-gradient(90deg, transparent, var(--color-cult-turquoise));
  }

  .footer-final-filete .filete-line:last-child {
    background: linear-gradient(90deg, var(--color-cult-turquoise), transparent);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-cult-text-dim);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-extra-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .dev-admin-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-cult-gold);
    background: rgba(244, 182, 63, 0.1);
    border: 1px solid rgba(244, 182, 63, 0.25);
    padding: 2px 7px;
    border-radius: 4px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .dev-admin-link:hover {
    background: rgba(244, 182, 63, 0.2);
    border-color: var(--color-cult-gold);
  }

  .sdd-badge {
    color: var(--color-cult-text-dim);
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .footer-nav-columns {
      gap: var(--space-8);
    }

    .footer-container {
      padding: var(--space-8) var(--space-4) var(--space-6);
    }
  }
</style>
