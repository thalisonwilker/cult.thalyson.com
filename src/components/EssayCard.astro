---
// src/components/EssayCard.astro
import { formatDate } from '../domain/reading-time';
import { getEssayUrl } from '../domain/routes';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date | string;
  category: string;
  territory?: 'para' | 'nacional' | 'global';
  locality?: string;
  readingTimeMinutes: number;
  coverImage?: string;
  coverImagePosition?: string;
  tags?: string[];
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  territory = 'para',
  locality,
  readingTimeMinutes,
  coverImage,
  coverImagePosition,
  tags = []
} = Astro.props;

const categoryLabels: Record<string, string> = {
  cinema: 'Cinema',
  literatura: 'Literatura',
  musica: 'Música',
  ensaios: 'Ensaios',
  artes: 'Artes Visuais',
  patrimonio: 'Patrimônio',
  gastronomia: 'Gastronomia'
};

const categoryAccents: Record<string, string> = {
  musica: 'var(--color-cult-gold)',
  patrimonio: 'var(--color-cult-coral)',
  cinema: 'var(--color-cult-orange)',
  literatura: 'var(--color-cult-turquoise)',
  artes: 'var(--color-cult-cobalt)',
  ensaios: 'var(--color-cult-turquoise)',
  gastronomia: 'var(--color-cult-orange)'
};

const defaultImage = territory === 'para'
  ? '/images/carimbo-guitarrada-noite.jpg'
  : '/images/belem-noite-estrelada.jpg';

const imageSrc = coverImage || defaultImage;
const essayUrl = getEssayUrl(category, slug);
---

<article class="editorial-story-card" data-category={category}>
  <a href={essayUrl} class="card-thumb-link" tabindex="-1" aria-hidden="true">
    <div class="card-thumb-frame">
      <img
        src={imageSrc}
        alt={`Imagem de capa: ${title}`}
        class="card-thumb-img"
        loading="lazy"
        style={coverImagePosition ? `object-position: ${coverImagePosition};` : undefined}
      />
      <div class="thumb-scrim" aria-hidden="true"></div>
      <span
        class="card-category-tag"
        style={`--tag-accent: ${categoryAccents[category] || 'var(--color-cult-turquoise)'};`}
      >
        {categoryLabels[category] || category}
      </span>
    </div>
  </a>

  <div class="card-content-wrap">
    <div class="card-meta-line">
      {locality ? (
        <span class="badge-locality">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          {locality}
        </span>
      ) : (
        <span class="badge-territory">
          {territory === 'para' ? 'Pará' : territory === 'nacional' ? 'Brasil' : 'Mundo'}
        </span>
      )}
      <span class="meta-dot" aria-hidden="true">·</span>
      <time datetime={typeof pubDate === 'string' ? pubDate : pubDate.toISOString()} class="card-date">
        {formatDate(pubDate)}
      </time>
      <span class="meta-dot" aria-hidden="true">·</span>
      <span class="card-time">{readingTimeMinutes} min</span>
    </div>

    <h3 class="card-headline">
      <a href={essayUrl} class="headline-link">
        {title}
      </a>
    </h3>

    <p class="card-summary">
      {description}
    </p>

    <div class="card-bottom-row">
      <a href={essayUrl} class="read-action-link">
        <span>Ler ensaio</span>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>

      {tags.length > 0 && (
        <div class="tags-cluster">
          {tags.slice(0, 2).map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  /* ============================================================
     Card Editorial de Revista
     ============================================================ */
  .editorial-story-card {
    background-color: var(--color-cult-surface);
    border: 1px solid var(--color-border);
    border-bottom: 3px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition:
      transform var(--transition-normal),
      border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .editorial-story-card:hover {
    transform: translate(-2px, -2px);
    border-color: var(--color-border-strong);
    border-bottom-color: var(--color-cult-turquoise);
    box-shadow: 4px 4px 0 #17A9B8;
  }

  .card-thumb-link {
    display: block;
    overflow: hidden;
  }

  .card-thumb-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-cult-surface-raised);
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .editorial-story-card:hover .card-thumb-img {
    transform: scale(1.03);
  }

  .thumb-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(7, 13, 34, 0.75) 100%);
    pointer-events: none;
  }

  .card-category-tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    background-color: rgba(7, 13, 34, 0.85);
    border: 1px solid var(--tag-accent);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .card-content-wrap {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-cult-text-dim);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .badge-territory {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-cult-text-muted);
    text-transform: uppercase;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }

  .meta-dot {
    color: var(--color-cult-border-strong);
  }

  .card-headline {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }

  .headline-link {
    color: var(--color-cult-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .headline-link:hover {
    color: var(--color-cult-coral);
  }

  .card-summary {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-cult-text-muted);
    margin-bottom: var(--space-6);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .read-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-cult-turquoise);
    text-decoration: none;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .read-action-link:hover {
    color: var(--color-cult-gold);
    gap: 0.55rem;
  }

  .tags-cluster {
    display: flex;
    gap: 0.35rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-cult-text-dim);
  }
</style>
