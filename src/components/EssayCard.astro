---
// src/components/EssayCard.astro
import { formatDate } from '../domain/reading-time';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date | string;
  category: 'cinema' | 'literatura' | 'musica' | 'ensaios' | 'artes' | 'patrimonio' | 'gastronomia';
  territory?: 'para' | 'nacional' | 'global';
  locality?: string;
  readingTimeMinutes: number;
  tags?: string[];
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  territory = 'para',
  locality,
  readingTimeMinutes,
  tags = []
} = Astro.props;

const categoryLabels: Record<string, string> = {
  cinema: 'Cinema',
  literatura: 'Literatura',
  musica: 'Música',
  ensaios: 'Ensaios & Crítica',
  artes: 'Artes Visuais',
  patrimonio: 'Patrimônio Vivo',
  gastronomia: 'Gastronomia & Saberes'
};

const territoryLabels: Record<string, string> = {
  para: 'Cultura Paraense',
  nacional: 'Brasil',
  global: 'Mundo'
};
---

<article class="essay-card" data-category={category} data-territory={territory}>
  <div class="card-header">
    <div class="badges-group">
      <span class="badge-category" data-category={category}>
        {categoryLabels[category] || category}
      </span>
      {locality ? (
        <span class="badge-locality">📍 {locality}</span>
      ) : (
        <span class={`badge-territory badge-territory-${territory}`}>
          {territoryLabels[territory]}
        </span>
      )}
    </div>

    <span class="reading-meta">
      <time datetime={typeof pubDate === 'string' ? pubDate : pubDate.toISOString()}>
        {formatDate(pubDate)}
      </time>
      <span class="meta-separator">·</span>
      <span>{readingTimeMinutes} min de leitura</span>
    </span>
  </div>

  <h2 class="card-title">
    <a href={`/ensaios/${slug}`} class="card-title-link">
      {title}
    </a>
  </h2>

  <p class="card-description">
    {description}
  </p>

  {tags.length > 0 && (
    <div class="card-tags">
      {tags.map((tag) => (
        <span class="tag">#{tag}</span>
      ))}
    </div>
  )}
</article>

<style>
  .essay-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .essay-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .essay-card[data-territory="para"] {
    border-left: 4px solid var(--color-orange-hibiscus);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .badges-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .badge-locality {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-beniukon-bronze);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .badge-territory {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .badge-territory-para {
    color: var(--color-orange-hibiscus);
    font-weight: 600;
  }

  .reading-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-separator {
    opacity: 0.6;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    line-height: 1.3;
  }

  .card-title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title-link:hover {
    color: var(--color-primary);
  }

  .card-description {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }
</style>
