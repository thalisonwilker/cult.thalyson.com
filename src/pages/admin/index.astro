---
// ============================================================
// PAINEL ADMINISTRATIVO LOCAL — DEV ONLY (AC-1, AC-2)
// Esta rota não é emitida no build de produção graças ao guard abaixo.
// ============================================================
import '../../styles/tokens.css';
import '../../styles/admin.css';

import { getCategories, listEssays } from '../../infrastructure/editor-storage';

// Guard de ambiente: retorna 404 em build/produção
if (!import.meta.env.DEV) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const initialCategories = await getCategories();
const initialEssays = await listEssays();
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel Administrativo — cult.thalyson.com [DEV]</title>
</head>
<body>
  <div class="admin-root">

    <!-- Header do Admin -->
    <header class="admin-header">
      <div class="admin-header-container">
        <div class="admin-header-brand">
          <span class="admin-header-badge">DEV ONLY</span>
          <span class="admin-header-title">Painel Administrativo</span>
        </div>

        <nav class="admin-header-nav" aria-label="Navegação do Painel">
          <button class="admin-nav-tab active" id="tab-btn-publications" data-target="panel-publications">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <span>Publicações</span>
          </button>
          <button class="admin-nav-tab" id="tab-btn-categories" data-target="panel-categories">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            <span>Categorias</span>
          </button>
        </nav>

        <div class="admin-header-actions">
          <a href="/" target="_blank" class="admin-btn-site" title="Abrir portal em nova aba">
            <span>Ver Site</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
          <a href="/editor/" class="btn-primary-admin" id="btn-header-new">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Nova Publicação</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Conteúdo Principal -->
    <main class="admin-main">

      <!-- Cards de Métricas / Estatísticas -->
      <section class="admin-stats-grid" aria-label="Resumo do acervo">
        <!-- Card 1: Total Publicações -->
        <div class="admin-stat-card">
          <div class="admin-stat-top">
            <span class="admin-stat-label">Publicações</span>
            <div class="admin-stat-icon-wrapper blue" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            </div>
          </div>
          <div class="admin-stat-number" id="stat-total-publications">{initialEssays.length}</div>
          <div class="admin-stat-footer">
            <span class="stat-dot blue"></span>
            <span>no acervo local</span>
          </div>
        </div>

        <!-- Card 2: Publicadas -->
        <div class="admin-stat-card">
          <div class="admin-stat-top">
            <span class="admin-stat-label">Publicadas</span>
            <div class="admin-stat-icon-wrapper green" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
          <div class="admin-stat-number text-success" id="stat-published-count">{initialEssays.filter(e => !e.draft).length}</div>
          <div class="admin-stat-footer">
            <span class="stat-dot green"></span>
            <span>visíveis aos leitores</span>
          </div>
        </div>

        <!-- Card 3: Rascunhos -->
        <div class="admin-stat-card">
          <div class="admin-stat-top">
            <span class="admin-stat-label">Rascunhos</span>
            <div class="admin-stat-icon-wrapper amber" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
            </div>
          </div>
          <div class="admin-stat-number text-amber" id="stat-drafts-count">{initialEssays.filter(e => e.draft).length}</div>
          <div class="admin-stat-footer">
            <span class="stat-dot amber"></span>
            <span>em elaboração local</span>
          </div>
        </div>

        <!-- Card 4: Categorias -->
        <div class="admin-stat-card">
          <div class="admin-stat-top">
            <span class="admin-stat-label">Categorias</span>
            <div class="admin-stat-icon-wrapper gold" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            </div>
          </div>
          <div class="admin-stat-number text-turquoise" id="stat-total-categories">{initialCategories.length}</div>
          <div class="admin-stat-footer">
            <span class="stat-dot turquoise"></span>
            <span>ativas no categories.json</span>
          </div>
        </div>

        <!-- Card 5: Destaques -->
        <div class="admin-stat-card">
          <div class="admin-stat-top">
            <span class="admin-stat-label">Destaques</span>
            <div class="admin-stat-icon-wrapper gold" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
          </div>
          <div class="admin-stat-number text-gold" id="stat-featured-count">{initialEssays.filter(e => e.featured && !e.draft).length} / 3</div>
          <div class="admin-stat-footer">
            <span class="stat-dot gold"></span>
            <span>no bloco Em Destaque</span>
          </div>
        </div>
      </section>

      <!-- Painel 1: Publicações & Pesquisa -->
      <section id="panel-publications" class="admin-section-panel active" aria-label="Painel de Publicações">
        <div class="admin-panel-card">
          <div class="admin-panel-header">
            <div class="admin-panel-heading">
              <h1 class="admin-panel-title">Publicações do Acervo</h1>
              <p class="admin-panel-subtitle">Pesquise, filtre e acesse a edição rápida de qualquer publicação local.</p>
            </div>
            <a href="/editor/" class="btn-primary-admin">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Criar Nova Publicação</span>
            </a>
          </div>

          <!-- Barra de Busca & Filtros -->
          <div class="admin-toolbar">
            <div class="admin-search-wrapper">
              <svg class="admin-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input
                type="search"
                id="input-search-publications"
                class="admin-search-input"
                placeholder="Pesquisar publicações por título, slug, categoria ou autor…"
                aria-label="Pesquisar publicações"
              />
            </div>

            <!-- Filtro por Categoria -->
            <select id="select-filter-category" class="admin-filter-select" aria-label="Filtrar por Categoria">
              <option value="">Todas as Categorias</option>
              {initialCategories.map(cat => (
                <option value={cat.value}>{cat.label}</option>
              ))}
            </select>

            <!-- Filtro por Status -->
            <select id="select-filter-status" class="admin-filter-select" aria-label="Filtrar por Status">
              <option value="">Todos os Status</option>
              <option value="published">Apenas Publicados</option>
              <option value="draft">Apenas Rascunhos</option>
            </select>

            <!-- Contador de Resultados Integrado -->
            <div class="admin-toolbar-count" id="publications-count-info">
              Carregando…
            </div>
          </div>

          <!-- Tabela de Publicações -->
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th style="width: 44px; text-align: center;" title="Destacar na Home (máx. 3)">★</th>
                  <th>Publicação</th>
                  <th>Categoria</th>
                  <th>Território</th>
                  <th>Data</th>
                  <th>Status</th>
                  <th style="text-align: right;">Ações</th>
                </tr>
              </thead>
              <tbody id="publications-table-body">
                <!-- Inserido dinamicamente via JS -->
              </tbody>
            </table>

            <!-- Empty State -->
            <div id="publications-empty-state" class="admin-empty-state" style="display: none;">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <p>Nenhuma publicação encontrada para o filtro selecionado.</p>
              <button class="admin-btn-action" id="btn-clear-search">Limpar Pesquisa</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Painel 2: Gerenciamento de Categorias em Lista -->
      <section id="panel-categories" class="admin-section-panel" aria-label="Gerenciamento de Categorias">
        <div class="admin-panel-card">
          <div class="admin-panel-header">
            <div class="admin-panel-heading">
              <h2 class="admin-panel-title">Gerenciador de Categorias</h2>
              <p class="admin-panel-subtitle">
                Adicione, edite ou remova categorias do acervo cultural. As alterações são persistidas em <code>src/data/categories.json</code>.
              </p>
            </div>
          </div>

          <!-- Formulário para Adicionar Categoria -->
          <div class="admin-category-form">
            <div class="admin-category-form-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <span>Adicionar Nova Categoria</span>
            </div>

            <form id="form-add-category" class="admin-category-form-row">
              <div class="admin-form-group">
                <label class="admin-form-label" for="input-cat-name">Nome da Categoria (Label) *</label>
                <input
                  type="text"
                  id="input-cat-name"
                  class="admin-form-input"
                  placeholder="Ex: Dança & Expressão"
                  required
                />
              </div>

              <div class="admin-form-group">
                <label class="admin-form-label" for="input-cat-slug">Identificador (Slug / Value) *</label>
                <input
                  type="text"
                  id="input-cat-slug"
                  class="admin-form-input"
                  placeholder="Ex: danca"
                  required
                />
              </div>

              <button type="submit" class="btn-primary-admin" style="height: 38px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Adicionar</span>
              </button>
            </form>
            <div id="add-category-feedback" style="display:none; font-size: 0.8rem;"></div>
          </div>

          <!-- Lista Estruturada de Categorias -->
          <div class="admin-category-list" id="category-list-container">
            <!-- Inserido dinamicamente via JS -->
          </div>
        </div>
      </section>

    </main>

    <!-- Diálogo Modal de Exclusão (Publicação ou Categoria) -->
    <div id="admin-confirm-modal" class="admin-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-confirm-title">
      <div class="admin-modal-box">
        <h3 id="modal-confirm-title" class="admin-modal-title">Confirmar Exclusão</h3>
        <p id="modal-confirm-desc" class="admin-modal-desc">Tem certeza que deseja prosseguir?</p>
        <div class="admin-modal-actions">
          <button type="button" class="admin-btn-action" id="btn-modal-cancel">Cancelar</button>
          <button type="button" class="admin-btn-action delete" id="btn-modal-confirm">Confirmar Exclusão</button>
        </div>
      </div>
    </div>

    <!-- Diálogo Modal de Edição de Categoria -->
    <div id="admin-edit-category-modal" class="admin-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-edit-cat-title">
      <div class="admin-modal-box">
        <h3 id="modal-edit-cat-title" class="admin-modal-title">Editar Categoria</h3>
        <div class="admin-form-group">
          <label class="admin-form-label" for="edit-cat-name-input">Nome da Categoria (Label)</label>
          <input type="text" id="edit-cat-name-input" class="admin-form-input" />
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">Identificador (Slug - Imutável)</label>
          <input type="text" id="edit-cat-slug-display" class="admin-form-input" disabled style="opacity: 0.6; cursor: not-allowed;" />
        </div>
        <div class="admin-modal-actions">
          <button type="button" class="admin-btn-action" id="btn-edit-cat-cancel">Cancelar</button>
          <button type="button" class="btn-primary-admin" id="btn-edit-cat-save">Salvar Alterações</button>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div id="admin-toast" class="admin-toast" role="status" aria-live="polite">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-cult-turquoise);"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span id="admin-toast-text">Ação executada com sucesso!</span>
    </div>

  </div>

  <!-- Script Client-Side -->
  <script is:inline>
    // Estado local
    let state = {
      essays: [],
      categories: [],
      activeTab: 'publications',
      searchTerm: '',
      filterCategory: '',
      filterStatus: '',
      modalAction: null
    };

    // --- Toast ---
    function showToast(message) {
      const toast = document.getElementById('admin-toast');
      const text = document.getElementById('admin-toast-text');
      if (!toast || !text) return;
      text.textContent = message;
      toast.classList.add('visible');
      setTimeout(() => {
        toast.classList.remove('visible');
      }, 3500);
    }

    // --- Helpers de Slug ---
    function slugify(text) {
      return text
        .toString()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    // --- Carregamento de Dados ---
    async function loadData() {
      try {
        const [resEssays, resCategories] = await Promise.all([
          fetch('/api/editor/essays'),
          fetch('/api/editor/categories')
        ]);

        const dataEssays = await resEssays.json();
        const dataCategories = await resCategories.json();

        if (dataEssays.ok && Array.isArray(dataEssays.essays)) {
          state.essays = dataEssays.essays;
        }

        if (dataCategories.ok && Array.isArray(dataCategories.categories)) {
          state.categories = dataCategories.categories;
        }

        updateStats();
        renderPublications();
        renderCategories();
        updateCategoryFilterOptions();
      } catch (err) {
        console.error('Erro ao carregar dados do admin:', err);
      }
    }

    // --- Atualização de Métricas ---
    function updateStats() {
      const elPubs = document.getElementById('stat-total-publications');
      const elPublished = document.getElementById('stat-published-count');
      const elDrafts = document.getElementById('stat-drafts-count');
      const elCats = document.getElementById('stat-total-categories');
      const elFeatured = document.getElementById('stat-featured-count');

      const published = state.essays.filter(e => !e.draft).length;
      const drafts = state.essays.filter(e => e.draft).length;
      const featured = state.essays.filter(e => e.featured && !e.draft).length;

      if (elPubs) elPubs.textContent = state.essays.length;
      if (elPublished) elPublished.textContent = published;
      if (elDrafts) elDrafts.textContent = drafts;
      if (elCats) elCats.textContent = state.categories.length;
      if (elFeatured) elFeatured.textContent = `${featured} / 3`;
    }

    // --- Navegação por Abas ---
    function switchTab(tabId) {
      state.activeTab = tabId;

      document.querySelectorAll('.admin-nav-tab').forEach(btn => {
        const target = btn.getAttribute('data-target');
        const isActive = target === `panel-${tabId}`;
        btn.classList.toggle('active', isActive);
      });

      document.querySelectorAll('.admin-section-panel').forEach(panel => {
        const isTarget = panel.id === `panel-${tabId}`;
        panel.classList.toggle('active', isTarget);
      });

      // Sincroniza hash da URL
      window.location.hash = tabId;
    }

    // --- Renderização de Publicações ---
    function renderPublications() {
      const tbody = document.getElementById('publications-table-body');
      const emptyState = document.getElementById('publications-empty-state');
      const countInfo = document.getElementById('publications-count-info');
      if (!tbody) return;

      const filtered = state.essays.filter(pub => {
        const term = state.searchTerm.toLowerCase();
        const matchesTerm = !term ||
          pub.title.toLowerCase().includes(term) ||
          pub.slug.toLowerCase().includes(term) ||
          pub.category.toLowerCase().includes(term) ||
          (pub.author && pub.author.toLowerCase().includes(term));

        const matchesCategory = !state.filterCategory || pub.category === state.filterCategory;
        const matchesStatus = !state.filterStatus ||
          (state.filterStatus === 'published' && !pub.draft) ||
          (state.filterStatus === 'draft' && pub.draft);

        return matchesTerm && matchesCategory && matchesStatus;
      });

      if (countInfo) {
        countInfo.textContent = `Exibindo ${filtered.length} de ${state.essays.length} publicações`;
      }

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        if (emptyState) emptyState.style.display = 'flex';
        return;
      }

      if (emptyState) emptyState.style.display = 'none';

      tbody.innerHTML = filtered.map(pub => {
        const catObj = state.categories.find(c => c.value === pub.category);
        const catLabel = catObj ? catObj.label : pub.category;

        const territoryMap = {
          para: 'Pará & Belém',
          nacional: 'Nacional',
          global: 'Global'
        };
        const territoryLabel = territoryMap[pub.territory] || pub.territory || 'Pará & Belém';

        const statusBadge = pub.draft
          ? `<span class="admin-badge-draft">Rascunho</span>`
          : `<span class="admin-badge-published">Publicado</span>`;

        return `
          <tr data-slug="${pub.slug}">
            <td style="text-align: center;">
              <button
                type="button"
                class="admin-btn-star ${pub.featured ? 'is-featured' : ''}"
                data-slug="${pub.slug}"
                data-featured="${pub.featured ? 'true' : 'false'}"
                data-title="${pub.title.replace(/"/g, '&quot;')}"
                title="${pub.featured ? 'Remover dos destaques da Home' : 'Destacar na Home (máx. 3 no site)'}"
                aria-label="${pub.featured ? 'Remover destaque' : 'Destacar'}"
              >
                <i class="${pub.featured ? 'fa-solid fa-star' : 'fa-regular fa-star'}" aria-hidden="true"></i>
              </button>
            </td>
            <td>
              <div class="admin-pub-info">
                <a href="/editor/?slug=${pub.slug}" class="admin-pub-title">${pub.title}</a>
                <span class="admin-pub-slug">slug: ${pub.slug}</span>
              </div>
            </td>
            <td>
              <span class="admin-badge-category">${catLabel}</span>
            </td>
            <td style="color: var(--color-cult-text-muted); font-size: 0.82rem;">
              ${territoryLabel}
            </td>
            <td style="color: var(--color-cult-text-muted); font-size: 0.82rem;">
              ${pub.pubDate || '—'}
            </td>
            <td>
              ${statusBadge}
            </td>
            <td style="text-align: right;">
              <div class="admin-table-actions" style="justify-content: flex-end;">
                ${!pub.draft ? `<a href="/${encodeURIComponent((pub.category || 'ensaios').toLowerCase())}/${encodeURIComponent(pub.slug)}/" target="_blank" class="admin-btn-action view" title="Visualizar ensaio"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg><span>Ver</span></a>` : ''}
                <a href="/editor/?slug=${pub.slug}" class="admin-btn-action edit" title="Editar publicação no editor">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                  <span>Editar</span>
                </a>
                <button type="button" class="admin-btn-action delete btn-delete-pub" data-slug="${pub.slug}" data-title="${pub.title.replace(/"/g, '&quot;')}" title="Excluir publicação">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  <span>Excluir</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      // Liga eventos de estrela (toggle de destaque)
      tbody.querySelectorAll('.admin-btn-star').forEach(btn => {
        btn.addEventListener('click', async () => {
          const slug = btn.getAttribute('data-slug');
          const isFeatured = btn.getAttribute('data-featured') === 'true';
          const title = btn.getAttribute('data-title');
          const nextFeatured = !isFeatured;

          try {
            btn.setAttribute('disabled', 'true');
            const res = await fetch('/api/editor/featured', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug, featured: nextFeatured })
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Falha ao alterar destaque.');
            }

            if (data.unfeatured && data.unfeatured.length > 0) {
              const unfeaturedTitles = data.unfeatured.map(u => `"${u.title || u.slug}"`).join(', ');
              showToast(`"${title}" destacado! ${unfeaturedTitles} saiu dos destaques (limite de 3).`, 4000);
            } else {
              showToast(`"${title}" ${nextFeatured ? 'marcado como destaque!' : 'removido dos destaques.'}`);
            }

            await loadData();
          } catch (err) {
            showToast(err.message || 'Erro ao alterar destaque.', 3500);
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      });

      // Liga eventos de exclusão nas publicações
      tbody.querySelectorAll('.btn-delete-pub').forEach(btn => {
        btn.addEventListener('click', () => {
          const slug = btn.getAttribute('data-slug');
          const title = btn.getAttribute('data-title');
          openConfirmModal({
            title: 'Excluir Publicação',
            desc: `Tem certeza que deseja excluir permanentemente a publicação "${title}" (arquivo src/content/ensaios/${slug}.md)? Esta ação não pode ser desfeita.`,
            onConfirm: async () => {
              const res = await fetch(`/api/editor/essay?slug=${encodeURIComponent(slug)}`, {
                method: 'DELETE'
              });
              const data = await res.json();
              if (data.ok) {
                showToast(`Publicação "${title}" excluída com sucesso!`);
                await loadData();
              } else {
                alert(data.error || 'Erro ao excluir publicação.');
              }
            }
          });
        });
      });
    }

    // --- Renderização de Categorias ---
    function renderCategories() {
      const container = document.getElementById('category-list-container');
      if (!container) return;

      container.innerHTML = state.categories.map(cat => {
        const count = state.essays.filter(e => e.category === cat.value).length;
        const countText = count === 1 ? '1 publicação vinculada' : `${count} publicações vinculadas`;

        return `
          <div class="admin-category-item" data-value="${cat.value}">
            <div class="admin-category-meta">
              <span class="admin-category-name">${cat.label}</span>
              <span class="admin-category-slug">${cat.value}</span>
              <span class="admin-category-count">(${countText})</span>
            </div>
            <div class="admin-category-actions">
              <button type="button" class="admin-btn-action edit btn-edit-category" data-value="${cat.value}" data-label="${cat.label.replace(/"/g, '&quot;')}" title="Editar categoria">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                <span>Editar</span>
              </button>
              <button type="button" class="admin-btn-action delete btn-delete-category" data-value="${cat.value}" data-label="${cat.label.replace(/"/g, '&quot;')}" data-count="${count}" title="Excluir categoria">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Excluir</span>
              </button>
            </div>
          </div>
        `;
      }).join('');

      // Liga eventos de edição de categoria
      container.querySelectorAll('.btn-edit-category').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-value');
          const lab = btn.getAttribute('data-label');
          openEditCategoryModal(val, lab);
        });
      });

      // Liga eventos de exclusão de categoria
      container.querySelectorAll('.btn-delete-category').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-value');
          const lab = btn.getAttribute('data-label');
          const count = parseInt(btn.getAttribute('data-count') || '0', 10);

          let warning = count > 0 ? ` Atenção: Existem ${count} publicações cadastradas com esta categoria.` : '';

          openConfirmModal({
            title: 'Excluir Categoria',
            desc: `Tem certeza que deseja excluir a categoria "${lab}" (${val}) de src/data/categories.json?${warning}`,
            onConfirm: async () => {
              const res = await fetch('/api/editor/categories', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'delete', value: val })
              });
              const data = await res.json();
              if (data.ok) {
                showToast(`Categoria "${lab}" removida com sucesso!`);
                await loadData();
              } else {
                alert(data.error || 'Erro ao remover categoria.');
              }
            }
          });
        });
      });
    }

    // --- Atualização de Opções do Select de Filtro de Categoria ---
    function updateCategoryFilterOptions() {
      const select = document.getElementById('select-filter-category');
      if (!select) return;

      const currentVal = select.value;
      select.innerHTML = '<option value="">Todas as Categorias</option>' +
        state.categories.map(c => `<option value="${c.value}">${c.label}</option>`).join('');
      select.value = currentVal;
    }

    // --- Modal de Confirmação ---
    function openConfirmModal({ title, desc, onConfirm }) {
      const modal = document.getElementById('admin-confirm-modal');
      const elTitle = document.getElementById('modal-confirm-title');
      const elDesc = document.getElementById('modal-confirm-desc');
      if (!modal) return;

      if (elTitle) elTitle.textContent = title;
      if (elDesc) elDesc.textContent = desc;

      state.modalAction = onConfirm;
      modal.classList.add('open');
    }

    function closeConfirmModal() {
      const modal = document.getElementById('admin-confirm-modal');
      if (modal) modal.classList.remove('open');
      state.modalAction = null;
    }

    // --- Modal de Edição de Categoria ---
    let currentEditingCatValue = null;
    function openEditCategoryModal(value, currentLabel) {
      currentEditingCatValue = value;
      const modal = document.getElementById('admin-edit-category-modal');
      const inputName = document.getElementById('edit-cat-name-input');
      const inputSlug = document.getElementById('edit-cat-slug-display');
      if (!modal || !inputName || !inputSlug) return;

      inputName.value = currentLabel;
      inputSlug.value = value;
      modal.classList.add('open');
      inputName.focus();
    }

    function closeEditCategoryModal() {
      const modal = document.getElementById('admin-edit-category-modal');
      if (modal) modal.classList.remove('open');
      currentEditingCatValue = null;
    }

    // --- Inicialização e Eventos ---
    document.addEventListener('DOMContentLoaded', () => {
      // Abas
      document.querySelectorAll('.admin-nav-tab').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target');
          if (target === 'panel-publications') switchTab('publications');
          if (target === 'panel-categories') switchTab('categories');
        });
      });

      // Suporte a hash inicial na URL (#categories / #categorias)
      if (window.location.hash === '#categories' || window.location.hash === '#categorias') {
        switchTab('categories');
      }

      // Busca de publicações
      const inputSearch = document.getElementById('input-search-publications');
      if (inputSearch) {
        inputSearch.addEventListener('input', (e) => {
          state.searchTerm = e.target.value;
          renderPublications();
        });
      }

      // Filtro por categoria
      const selectCat = document.getElementById('select-filter-category');
      if (selectCat) {
        selectCat.addEventListener('change', (e) => {
          state.filterCategory = e.target.value;
          renderPublications();
        });
      }

      // Filtro por status
      const selectStatus = document.getElementById('select-filter-status');
      if (selectStatus) {
        selectStatus.addEventListener('change', (e) => {
          state.filterStatus = e.target.value;
          renderPublications();
        });
      }

      // Limpar busca
      const btnClear = document.getElementById('btn-clear-search');
      if (btnClear) {
        btnClear.addEventListener('click', () => {
          state.searchTerm = '';
          state.filterCategory = '';
          state.filterStatus = '';
          if (inputSearch) inputSearch.value = '';
          if (selectCat) selectCat.value = '';
          if (selectStatus) selectStatus.value = '';
          renderPublications();
        });
      }

      // Auto-preenchimento de slug ao digitar nome da categoria
      const inputCatName = document.getElementById('input-cat-name');
      const inputCatSlug = document.getElementById('input-cat-slug');
      if (inputCatName && inputCatSlug) {
        inputCatName.addEventListener('input', () => {
          if (!inputCatSlug.dataset.manual) {
            inputCatSlug.value = slugify(inputCatName.value);
          }
        });
        inputCatSlug.addEventListener('input', () => {
          inputCatSlug.dataset.manual = 'true';
        });
      }

      // Adicionar categoria form
      const formAddCategory = document.getElementById('form-add-category');
      const addFeedback = document.getElementById('add-category-feedback');
      if (formAddCategory) {
        formAddCategory.addEventListener('submit', async (e) => {
          e.preventDefault();
          const label = inputCatName ? inputCatName.value.trim() : '';
          const value = inputCatSlug ? slugify(inputCatSlug.value.trim()) : '';

          if (!label || !value) {
            if (addFeedback) {
              addFeedback.style.display = 'block';
              addFeedback.style.color = 'var(--color-cult-coral)';
              addFeedback.textContent = 'Preencha o Nome e o Identificador da categoria.';
            }
            return;
          }

          if (state.categories.some(c => c.value === value)) {
            if (addFeedback) {
              addFeedback.style.display = 'block';
              addFeedback.style.color = 'var(--color-cult-coral)';
              addFeedback.textContent = `A categoria "${value}" já existe.`;
            }
            return;
          }

          try {
            const res = await fetch('/api/editor/categories', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'add', item: { value, label } })
            });
            const data = await res.json();
            if (data.ok) {
              formAddCategory.reset();
              if (inputCatSlug) delete inputCatSlug.dataset.manual;
              if (addFeedback) addFeedback.style.display = 'none';
              showToast(`Categoria "${label}" adicionada com sucesso!`);
              await loadData();
            } else {
              if (addFeedback) {
                addFeedback.style.display = 'block';
                addFeedback.style.color = 'var(--color-cult-coral)';
                addFeedback.textContent = data.error || 'Erro ao adicionar categoria.';
              }
            }
          } catch (err) {
            console.error('Erro ao adicionar categoria:', err);
          }
        });
      }

      // Modal de Confirmação botões
      document.getElementById('btn-modal-cancel')?.addEventListener('click', closeConfirmModal);
      document.getElementById('btn-modal-confirm')?.addEventListener('click', () => {
        if (typeof state.modalAction === 'function') {
          state.modalAction();
        }
        closeConfirmModal();
      });

      // Modal de Edição de Categoria botões
      document.getElementById('btn-edit-cat-cancel')?.addEventListener('click', closeEditCategoryModal);
      document.getElementById('btn-edit-cat-save')?.addEventListener('click', async () => {
        const inputName = document.getElementById('edit-cat-name-input');
        const newLabel = inputName ? inputName.value.trim() : '';
        if (!newLabel || !currentEditingCatValue) return;

        try {
          const res = await fetch('/api/editor/categories', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'update', value: currentEditingCatValue, label: newLabel })
          });
          const data = await res.json();
          if (data.ok) {
            closeEditCategoryModal();
            showToast(`Categoria "${newLabel}" atualizada com sucesso!`);
            await loadData();
          } else {
            alert(data.error || 'Erro ao atualizar categoria.');
          }
        } catch (err) {
          console.error('Erro ao editar categoria:', err);
        }
      });

      // Carrega dados iniciais
      loadData();
    });
  </script>
</body>
</html>
