---
// src/pages/ensaios/[slug].astro
import { getCollection } from 'astro:content';
import { getEssayUrl } from '../../domain/routes';

export async function getStaticPaths() {
  const ensaios = await getCollection('ensaios');
  return ensaios
    .filter((essay) => essay.data.category.trim().toLowerCase() !== 'ensaios')
    .map((essay) => ({
      params: { slug: essay.slug },
      props: {
        targetUrl: getEssayUrl(essay.data.category, essay.slug),
        title: essay.data.title
      }
    }));
}

interface Props {
  targetUrl: string;
  title: string;
}

const { targetUrl, title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
    <title>Redirecionando para {title} — CULT</title>
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #0c1a24; color: #fdfaf2; padding: 2rem; text-align: center;">
    <p>Redirecionando para <a href={targetUrl} style="color: #17a9b8; text-decoration: underline;">{targetUrl}</a>...</p>
  </body>
</html>
