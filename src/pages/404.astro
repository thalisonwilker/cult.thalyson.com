---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página Não Encontrada — CULT" description="A página que você procura não foi encontrada.">
  <div class="not-found-container">
    <div class="not-found-badge">Erro 404</div>
    <h1 class="not-found-title">Caminho pelas águas não encontrado</h1>
    <p class="not-found-text">
      Assim como um barco que desvia da rota na Baía do Guajará, esta página não pôde ser localizada.
      Retorne à margem segura para continuar navegando pelos saberes e artes do Pará.
    </p>
    <a href="/" class="not-found-button">
      <i class="fa-solid fa-house" aria-hidden="true"></i>
      Voltar para o Início
    </a>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50vh;
    padding: 4rem 1.5rem;
    margin: 2rem auto;
    max-width: 600px;
  }

  .not-found-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-coral, #EC5B5B);
    background: rgba(236, 91, 91, 0.12);
    border: 1px solid rgba(236, 91, 91, 0.3);
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .not-found-title {
    font-family: var(--font-display, 'Fraunces', serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--color-text, #E8EDF7);
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .not-found-text {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted, #94A3B8);
    margin: 0 0 2rem;
  }

  .not-found-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.8rem;
    background: var(--color-cult-gold);
    color: var(--color-cult-navy-deep);
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    border: 2px solid var(--color-cult-cream);
    box-shadow: 4px 4px 0 var(--color-cult-turquoise);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .not-found-button:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--color-cult-turquoise);
    color: var(--color-cult-navy-deep);
  }
</style>
