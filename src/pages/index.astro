---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayCard from '../components/EssayCard.astro';
import ParaHighlightHero from '../components/ParaHighlightHero.astro';
import TerritoryFilter from '../components/TerritoryFilter.astro';
import { calculateReadingTime } from '../domain/reading-time';

const allEssays = await getCollection('ensaios', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Ordena por data de publicação decrescente
allEssays.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const currentCategory = Astro.url.searchParams.get('categoria') || undefined;
const currentTerritory = Astro.url.searchParams.get('territorio') || undefined;

// Filtragem combinada (território e categoria)
const filteredEssays = allEssays.filter((essay) => {
  const matchCategory = currentCategory ? essay.data.category === currentCategory : true;
  const matchTerritory = currentTerritory && currentTerritory !== 'all'
    ? essay.data.territory === currentTerritory
    : true;
  return matchCategory && matchTerritory;
});

// Separação em seções quando na visão padrão (sem filtro ativo)
const isDefaultView = !currentCategory && (!currentTerritory || currentTerritory === 'all');
---

<BaseLayout
  title="CULT — Acervo & Curadoria da Cultura do Pará, Belém e Artes"
  description="Polo agregador de ensaios e curadoria sobre a música, cinema, literatura cabocla, Círio, gastronomia e tradições do Pará, em diálogo com o Brasil e o Mundo."
  currentCategory={currentCategory}
>
  <ParaHighlightHero />

  <section class="feed-section">
    <TerritoryFilter
      currentTerritory={currentTerritory}
      currentCategory={currentCategory}
    />

    <div class="feed-header">
      <h2 class="feed-title">
        {currentTerritory === 'para' && 'Acervo do Pará & Belém'}
        {currentTerritory === 'nacional' && 'Arte & Cultura Nacional'}
        {currentTerritory === 'global' && 'Mundo & Clássicos Universais'}
        {isDefaultView && 'Todas as Publicações Recentes'}
        {currentCategory && !currentTerritory && `Categoria: ${currentCategory}`}
      </h2>
      <span class="feed-count">
        {filteredEssays.length} {filteredEssays.length === 1 ? 'ensaio' : 'ensaios'}
      </span>
    </div>

    {filteredEssays.length > 0 ? (
      <div class="essays-grid">
        {filteredEssays.map((essay) => (
          <EssayCard
            title={essay.data.title}
            description={essay.data.description}
            slug={essay.slug}
            pubDate={essay.data.pubDate}
            category={essay.data.category}
            territory={essay.data.territory}
            locality={essay.data.locality}
            readingTimeMinutes={calculateReadingTime(essay.body)}
            tags={essay.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Nenhum ensaio encontrado para os filtros selecionados.</p>
        <a href="/" class="empty-link">Ver todo o acervo</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .feed-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .feed-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }

  .feed-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .feed-count {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .essays-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
