---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayCard from '../components/EssayCard.astro';
import { calculateReadingTime } from '../domain/reading-time';

const allEssays = await getCollection('ensaios', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Ordena por data de publicação decrescente
allEssays.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const currentCategory = Astro.url.searchParams.get('categoria') || undefined;

const filteredEssays = currentCategory
  ? allEssays.filter((essay) => essay.data.category === currentCategory)
  : allEssays;
---

<BaseLayout
  title="CULT — Acervo & Curadoria Cultural por Thalyson"
  description="Reflexões, ensaios aprofundados e resenhas críticas sobre cinema, literatura, música e artes visuais."
  currentCategory={currentCategory}
>
  <section class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">Acervo Editorial</span>
      <h1 class="hero-title">
        Reflexões sobre cinema, livros, música e a vida estética.
      </h1>
      <p class="hero-lead">
        Um espaço de curadoria crítica e ensaios aprofundados, livre do ruído algorítmico e focado na experiência perene da leitura.
      </p>
    </div>
  </section>

  <section class="essays-feed">
    <div class="feed-header">
      <h2 class="feed-title">
        {currentCategory ? `Ensaios em ${currentCategory}` : 'Publicações Recentes'}
      </h2>
      <span class="feed-count">
        {filteredEssays.length} {filteredEssays.length === 1 ? 'ensaio' : 'ensaios'}
      </span>
    </div>

    {filteredEssays.length > 0 ? (
      <div class="essays-grid">
        {filteredEssays.map((essay) => (
          <EssayCard
            title={essay.data.title}
            description={essay.data.description}
            slug={essay.slug}
            pubDate={essay.data.pubDate}
            category={essay.data.category}
            readingTimeMinutes={calculateReadingTime(essay.body)}
            tags={essay.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Nenhum ensaio encontrado nesta categoria ainda.</p>
        <a href="/" class="empty-link">Ver todos os ensaios</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 2.5rem 0 3.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-badge {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-fusion-red);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .essays-feed {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .feed-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }

  .feed-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .feed-count {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .essays-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    .hero-lead {
      font-size: 1.1rem;
    }
  }
</style>
