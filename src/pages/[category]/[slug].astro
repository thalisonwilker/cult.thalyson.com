---
// src/pages/[category]/[slug].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculateReadingTime, formatDate } from '../../domain/reading-time';

export async function getStaticPaths() {
  const ensaios = await getCollection('ensaios');
  return ensaios.map((essay) => ({
    params: {
      category: essay.data.category.trim().toLowerCase(),
      slug: essay.slug
    },
    props: { essay }
  }));
}

interface Props {
  essay: CollectionEntry<'ensaios'>;
}

const { essay } = Astro.props;
const { Content } = await essay.render();
const readingTime = calculateReadingTime(essay.body);

const categoryLabels: Record<string, string> = {
  cinema: 'Cinema',
  literatura: 'Literatura',
  musica: 'Música',
  ensaios: 'Ensaios & Crítica',
  artes: 'Artes Visuais',
  patrimonio: 'Patrimônio Vivo',
  gastronomia: 'Gastronomia & Saberes',
  cultura: 'Cultura Geral'
};

const territoryLabels: Record<string, string> = {
  para: 'Cultura Paraense',
  nacional: 'Arte Nacional',
  global: 'Mundo'
};
---

<BaseLayout
  title={`${essay.data.title} — CULT`}
  description={essay.data.description}
  currentCategory={essay.data.category}
>
  <article class="essay-article">
    <header class="article-header">
      <div class="article-meta-top">
        <div class="badges-row">
          <a href={`/?categoria=${essay.data.category}`} class="badge-category" data-category={essay.data.category}>
            {categoryLabels[essay.data.category] || essay.data.category}
          </a>
          {essay.data.locality ? (
            <span class="badge-locality">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i> {essay.data.locality}
            </span>
          ) : (
            <span class="badge-territory">{territoryLabels[essay.data.territory]}</span>
          )}
          {import.meta.env.DEV && (
            <a
              href={`/editor/?slug=${essay.slug}`}
              class="dev-edit-btn"
              title="Editar esta publicação no Editor Local (DEV)"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              <span>Editar Publicação</span>
            </a>
          )}
        </div>

        <span class="reading-meta">
          <time datetime={essay.data.pubDate.toISOString()}>
            {formatDate(essay.data.pubDate)}
          </time>
          <span class="separator">·</span>
          <span>{readingTime} min de leitura</span>
        </span>
      </div>

      <h1 class="article-title">
        {essay.data.title}
      </h1>

      <p class="article-lead">
        {essay.data.description}
      </p>

      <div class="article-author-bar">
        <span class="author-label">Por <strong>{essay.data.author}</strong></span>
        {essay.data.tags.length > 0 && (
          <div class="article-tags">
            {essay.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </div>

      {essay.data.coverImage && (
        <div class="article-cover-wrapper">
          <img
            src={essay.data.coverImage}
            alt={`Ilustração artística para o ensaio ${essay.data.title}`}
            class="article-cover-img"
            style={essay.data.coverImagePosition ? `object-position: ${essay.data.coverImagePosition};` : undefined}
          />
        </div>
      )}
    </header>

    <div class="article-divider"></div>

    <div class="article-content prose">
      <Content />
    </div>

    <footer class="article-footer">
      <div class="back-nav">
        <a href="/" class="back-link">
          ← Voltar para o acervo cultural
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .essay-article {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .badges-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-locality {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-cult-gold);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .badge-territory {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .reading-meta {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .separator {
    opacity: 0.6;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .article-lead {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: 2rem;
  }

  .article-author-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .article-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--color-surface-hover);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .article-cover-wrapper {
    margin-top: 2rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 2px solid var(--color-border);
    background-color: var(--color-cult-surface-raised);
  }

  .article-cover-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-divider {
    height: 1px;
    background-color: var(--color-border);
    margin: 2rem 0 3rem;
  }

  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .back-link:hover {
    transform: translateX(-3px);
  }

  .dev-edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(23, 169, 184, 0.12);
    border: 1px solid rgba(23, 169, 184, 0.35);
    color: var(--color-cult-turquoise);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .dev-edit-btn:hover {
    background: var(--color-cult-turquoise);
    color: var(--color-cult-navy-deep);
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 2.1rem;
    }
    .article-lead {
      font-size: 1.15rem;
    }
  }
</style>
