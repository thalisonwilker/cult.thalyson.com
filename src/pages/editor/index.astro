// TOOLBAR DE FORMATAÇÃO (AC-5)
// ============================================================
function insertAtCursor(textarea, before, after = '') {
  const start = textarea.selectionStart;
  const end = textarea.selectionEnd;
  const selected = textarea.value.substring(start, end);
  const newText = before + (selected || 'texto') + after;
  textarea.value = textarea.value.substring(0, start) + newText + textarea.value.substring(end);
  // Reposiciona o cursor
  const newStart = start + before.length;
  const newEnd = newStart + (selected || 'texto').length;
  textarea.setSelectionRange(newStart, newEnd);
  textarea.focus();
  updatePreview();
  debouncedSave();
}

function insertLinePrefix(textarea, prefix) {
  const start = textarea.selectionStart;
  const lineStart = textarea.value.lastIndexOf('\n', start - 1) + 1;
  const before = textarea.value.substring(0, lineStart);
  const after = textarea.value.substring(lineStart);
  textarea.value = before + prefix + after;
  const newPos = lineStart + prefix.length;
  textarea.setSelectionRange(newPos, newPos);
  textarea.focus();
  updatePreview();
  debouncedSave();
}

document.querySelectorAll('.editor-toolbar-btn[data-action]').forEach(btn => {
  btn.addEventListener('click', () => {
    const textarea = /** @type {HTMLTextAreaElement} */ (document.getElementById('field-body'));
    if (!textarea) return;
    const action = btn.getAttribute('data-action');
    switch (action) {
      case 'bold':   insertAtCursor(textarea, '**', '**'); break;
      case 'italic': insertAtCursor(textarea, '_', '_'); break;
      case 'h2':     insertLinePrefix(textarea, '## '); break;
      case 'h3':     insertLinePrefix(textarea, '### '); break;
      case 'quote':  insertLinePrefix(textarea, '> '); break;
      case 'code':   insertAtCursor(textarea, '`', '`'); break;
      case 'ul':     insertLinePrefix(textarea, '- '); break;
      case 'hr':
        const curPos = textarea.selectionStart;
        const ins = '\n\n---\n\n';
        textarea.value = textarea.value.substring(0, curPos) + ins + textarea.value.substring(curPos);
        textarea.setSelectionRange(curPos + ins.length, curPos + ins.length);
        textarea.focus();
        updatePreview();
        debouncedSave();
        break;
      case 'link':
        openLinkDialog();
        break;
    }
  });
});

