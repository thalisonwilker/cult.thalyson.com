let previewTimer;

function updatePreview() {
  clearTimeout(previewTimer);
  previewTimer = setTimeout(() => {
    const title = getVal('field-title');
    const body = getVal('field-body');
    const category = getVal('field-category');
    const territory = getVal('field-territory');
    const author = getVal('field-author') || 'Thalyson';
    const pubdate = getVal('field-pubdate');

    const previewContent = document.getElementById('preview-content');
    const previewMeta = /** @type {HTMLElement} */ (document.getElementById('preview-meta'));
    const outputSection = /** @type {HTMLElement} */ (document.getElementById('output-section'));
    const outputFrontmatter = document.getElementById('output-frontmatter');

    // Atualizar contador de caracteres
    const charCount = document.getElementById('char-count');
    if (charCount) charCount.textContent = `${body.length.toLocaleString('pt-BR')} caracteres`;

    // Atualizar meta badges
    if (previewMeta) {
      if (category || territory || author || pubdate) {
        previewMeta.style.display = 'flex';
        const catBadge = document.getElementById('preview-badge-category');
        const terBadge = document.getElementById('preview-badge-territory');
        const autBadge = document.getElementById('preview-badge-author');
        const datBadge = document.getElementById('preview-badge-date');
        const ICONS = {
          category: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>',
          territory: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>',
          author: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>',
          date: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>',
        };
        if (catBadge) {
          catBadge.style.display = category ? 'inline-flex' : 'none';
          catBadge.innerHTML = category ? `${ICONS.category}<span>${category}</span>` : '';
        }
        if (terBadge) {
          terBadge.style.display = territory ? 'inline-flex' : 'none';
          terBadge.innerHTML = territory ? `${ICONS.territory}<span>${territory}</span>` : '';
        }
        if (autBadge) {
          autBadge.style.display = author ? 'inline-flex' : 'none';
          autBadge.innerHTML = author ? `${ICONS.author}<span>${author}</span>` : '';
        }
        if (datBadge) {
          datBadge.style.display = pubdate ? 'inline-flex' : 'none';
          datBadge.innerHTML = pubdate ? `${ICONS.date}<span>${pubdate}</span>` : '';
        }
      } else {
        previewMeta.style.display = 'none';
      }
    }

    // Renderizar markdown
    if (previewContent) {
      const hasContent = title || body;
      if (!hasContent) {
        previewContent.innerHTML = `
          <div class="editor-preview-empty">
            <span class="editor-preview-empty-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
            </span>
            <span>O preview aparece aqui enquanto você escreve.</span>
          </div>`;
      } else {
        // @ts-ignore — marked é carregado via CDN
        const rendered = typeof marked !== 'undefined'
          // @ts-ignore
          ? marked.parse((title ? `# ${title}\n\n` : '') + body)
          : `<h1>${title}</h1><p>${body}</p>`;
        // @ts-ignore — DOMPurify é carregado via CDN
        const clean = typeof DOMPurify !== 'undefined' ? DOMPurify.sanitize(rendered) : rendered;
        previewContent.innerHTML = clean;
      }
    }

    // Gerar frontmatter
    if (title && outputSection && outputFrontmatter) {
      outputSection.style.display = 'block';
      outputFrontmatter.textContent = generateFrontmatter();
    } else if (outputSection) {
      outputSection.style.display = 'none';
    }
  }, 200);
}

// ============================================================
// GERAÇÃO DE FRONTMATTER YAML (AC-3, AC-6)
// ============================================================
function generateFrontmatter() {
  const title = getVal('field-title');
  const description = getVal('field-description');
  const category = getVal('field-category');
  const territory = getVal('field-territory') || 'para';
  const locality = getVal('field-locality');
  const author = getVal('field-author') || 'Thalyson';
  const pubdate = getVal('field-pubdate') || new Date().toISOString().split('T')[0];
  const draft = (/** @type {HTMLInputElement} */ (document.getElementById('field-draft')))?.checked || false;
  const featured = (/** @type {HTMLInputElement} */ (document.getElementById('field-featured')))?.checked || false;
  const tags = state.tags;
  const coverImage = state.coverImagePath;

  let fm = `---\n`;
  fm += `title: "${title.replace(/"/g, '\\"')}"\n`;
  fm += `description: "${description.replace(/"/g, '\\"')}"\n`;
  fm += `pubDate: ${pubdate}\n`;
  fm += `category: ${category || 'ensaios'}\n`;
  fm += `territory: ${territory}\n`;
  if (locality) fm += `locality: "${locality}"\n`;
  fm += `author: ${author}\n`;
  fm += `tags: [${tags.map(t => `"${t}"`).join(', ')}]\n`;
  fm += `draft: ${draft}\n`;
  fm += `featured: ${featured}\n`;
  if (coverImage) fm += `coverImage: "${coverImage}"\n`;
  if (state.coverImagePosition && state.coverImagePosition !== '50% 50%') {
    fm += `coverImagePosition: "${state.coverImagePosition}"\n`;
  }
  fm += `---`;
  return fm;
}


// ============================================================
// SALVAR DIRETAMENTE EM DISCO (AC-11)
// ============================================================
async function saveLocalPublication() {
  clearFeedback();
  const title = getVal('field-title');
  if (!title) {
    showFeedback('Título obrigatório — preencha o título antes de salvar.', 'error');
    document.getElementById('field-title')?.focus();
    return;
  }
  const category = getVal('field-category');
  if (!category) {
    showFeedback('Categoria obrigatória — selecione uma categoria.', 'error');
    document.getElementById('field-category')?.focus();
    return;
  }

  const saveBtn = document.getElementById('btn-save-local');
  const saveLabel = document.getElementById('btn-save-label');
  if (saveBtn) saveBtn.setAttribute('disabled', 'true');
  if (saveLabel) saveLabel.textContent = 'Salvando…';

  const payload = {
    title,
    description: getVal('field-description'),
    category,
    territory: getVal('field-territory') || 'para',
    locality: getVal('field-locality'),
    author: getVal('field-author') || 'Thalyson',
    pubDate: state.pubDate || getTodayDate(),
    tags: [...state.tags],
    draft: (/** @type {HTMLInputElement} */ (document.getElementById('field-draft')))?.checked || false,
    featured: (/** @type {HTMLInputElement} */ (document.getElementById('field-featured')))?.checked || false,
    coverImage: state.coverImagePath,
    coverImagePosition: state.coverImagePosition || '50% 50%',
    body: getVal('field-body'),
    slug: state.currentSlug || '',
    originalSlug: state.originalSlug || ''
  };

  try {
    const res = await fetch('/api/editor/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      throw new Error(data.error || 'Falha ao salvar no filesystem.');
    }

    state.currentSlug = data.slug;
    state.originalSlug = data.slug;

    // Atualiza indicador de edição e exibe botão de exclusão
    const indicator = document.getElementById('editor-editing-indicator');
    if (indicator) {
      indicator.textContent = `Editando: ${data.slug}`;
      indicator.style.display = 'inline-block';
    }
    updateDeleteButtonVisibility();

    // Atualiza lista de publicações e seleciona a atual
    await loadLocalEssaysList(data.slug);

    // Limpa draft salvo no localStorage pois o conteúdo já está em disco
    clearDraft();

    if (data.unfeatured && data.unfeatured.length > 0) {
      const removedList = data.unfeatured.map(u => `"${u.title || u.slug}"`).join(', ');
      showToast(`Publicação salva! ${removedList} saiu dos destaques (limite de 3).`, 4000);
    } else {
      showToast(`Publicação salva em ${data.path}!`);
    }
  } catch (err) {
    showFeedback(err.message || 'Erro ao salvar a publicação localmente.', 'error');
  } finally {
    if (saveBtn) saveBtn.removeAttribute('disabled');
    if (saveLabel) saveLabel.textContent = 'Salvar Publicação';
  }
}

document.getElementById('btn-save-local')?.addEventListener('click', saveLocalPublication);

