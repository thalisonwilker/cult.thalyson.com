// Botão 2: Recortar Imagem em 16:9 de Alta Definição e Salvar Arquivo
document.getElementById('btn-save-crop-file')?.addEventListener('click', async () => {
  const cropImg = /** @type {HTMLImageElement} */ (document.getElementById('crop-source-img'));
  if (!cropImg || !cropImg.src) return;

  const btn = /** @type {HTMLButtonElement} */ (document.getElementById('btn-save-crop-file'));
  const originalHtml = btn ? btn.innerHTML : '';
  if (btn) {
    btn.disabled = true;
    btn.textContent = 'Recortando…';
  }

  try {
    const fullImg = new Image();
    fullImg.crossOrigin = 'anonymous';
    await new Promise((resolve, reject) => {
      fullImg.onload = resolve;
      fullImg.onerror = reject;
      fullImg.src = cropImg.src;
    });

    const nw = fullImg.naturalWidth;
    const nh = fullImg.naturalHeight;
    const targetAspect = 16 / 9;
    const imgAspect = nw / nh;
    const zoom = cropState.zoom / 100;

    let cropWidth, cropHeight;
    if (imgAspect > targetAspect) {
      cropHeight = nh / zoom;
      cropWidth = cropHeight * targetAspect;
    } else {
      cropWidth = nw / zoom;
      cropHeight = cropWidth / targetAspect;
    }

    const maxSx = Math.max(0, nw - cropWidth);
    const maxSy = Math.max(0, nh - cropHeight);
    const sx = maxSx * (cropState.posX / 100);
    const sy = maxSy * (cropState.posY / 100);

    const outWidth = Math.min(1920, Math.max(1280, Math.round(cropWidth)));
    const outHeight = Math.round(outWidth / targetAspect);

    const canvas = document.createElement('canvas');
    canvas.width = outWidth;
    canvas.height = outHeight;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Não foi possível inicializar canvas 2D.');

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(fullImg, sx, sy, cropWidth, cropHeight, 0, 0, outWidth, outHeight);

    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
    if (!blob) throw new Error('Falha ao exportar recorte da imagem.');

    const curPath = state.coverImagePath || 'imagem.jpg';
    const rawName = curPath.split('/').pop()?.replace(/\.[^.]+$/, '') || 'imagem';
    const cleanName = rawName.replace(/-corte-\d+$/, '');
    const newFileName = `${cleanName}-corte-${Date.now().toString().slice(-4)}.jpg`;

    const res = await fetch('/api/editor/upload-image', {
      method: 'POST',
      headers: { 'x-filename': encodeURIComponent(newFileName) },
      body: blob
    });
    const data = await res.json();
    if (!data.ok || !data.path) {
      throw new Error(data.error || 'Erro no upload da imagem recortada.');
    }

    setExistingImagePreview(data.path, '50% 50%');
    closeCropModal();
    updatePreview();
    debouncedSave();
    showToast(`Imagem recortada em 16:9 e salva em ${data.path}!`);
  } catch (err) {
    showToast(`Erro ao recortar: ${err.message}`);
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    }
  }
});

