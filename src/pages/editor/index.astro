function renderCategoriesSelect() {
  const select = /** @type {HTMLSelectElement} */ (document.getElementById('field-category'));
  if (!select) return;
  const currentVal = select.value;
  select.innerHTML = '<option value="">Selecionar…</option>';
  state.categories.forEach(cat => {
    const opt = document.createElement('option');
    opt.value = cat.value;
    opt.textContent = cat.label;
    if (cat.value === currentVal) opt.selected = true;
    select.appendChild(opt);
  });
}

// ============================================================
// LISTENERS DE INPUT — save & preview
// ============================================================
const liveInputs = [
  'field-title','field-description','field-category','field-territory',
  'field-locality','field-author','field-body','field-draft','field-featured'
];
liveInputs.forEach(id => {
  const el = document.getElementById(id);
  el?.addEventListener('input', () => { updatePreview(); debouncedSave(); });
  el?.addEventListener('change', () => { updatePreview(); debouncedSave(); });
});

// ============================================================
// INICIALIZAÇÃO
// ============================================================
document.addEventListener('DOMContentLoaded', async () => {
  updatePubDateDisplay();

  // Carrega categorias do arquivo JSON
  await loadCategories();

  // Verifica se há parâmetro slug na URL para carregar ensaio existente
  const urlParams = new URLSearchParams(window.location.search);
  const targetSlug = urlParams.get('slug');

  if (targetSlug) {
    await loadEssayToEdit(targetSlug);
  } else {
    // Restaura rascunho se houver
    restoreDraft();
    renderTags();
    updatePreview();
  }
});
</script>

