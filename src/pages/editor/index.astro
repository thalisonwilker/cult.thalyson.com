// CARREGAR E GERENCIAR PUBLICAÇÕES LOCAIS (AC-12, AC-13)
// ============================================================
function updateDeleteButtonVisibility() {
  const btnDelete = document.getElementById('btn-delete-local');
  if (btnDelete) {
    btnDelete.style.display = state.currentSlug ? 'inline-flex' : 'none';
  }
}

async function loadLocalEssaysList(selectedSlug = state.currentSlug) {
  try {
    const res = await fetch('/api/editor/essays');
    const data = await res.json();
    if (data.ok && Array.isArray(data.essays)) {
      state.essays = data.essays;
    }
  } catch {
    // Silencioso em caso de falha de conexão
  }

  // Sincroniza query parameter ?slug na URL
  const url = new URL(window.location.href);
  if (selectedSlug) {
    url.searchParams.set('slug', selectedSlug);
    window.history.replaceState({}, '', url.toString());
  } else {
    url.searchParams.delete('slug');
    window.history.replaceState({}, '', url.pathname);
  }
}

async function loadEssayToEdit(slug) {
  if (!slug) return;
  try {
    const res = await fetch(`/api/editor/essay?slug=${encodeURIComponent(slug)}`);
    const data = await res.json();
    if (!data.ok || !data.essay) {
      showFeedback(`Não foi possível carregar a publicação "${slug}".`, 'error');
      return;
    }

    const essay = data.essay;
    state.currentSlug = essay.slug;
    state.originalSlug = essay.slug;
    state.pubDate = essay.pubDate;
    updatePubDateDisplay();

    setVal('field-title', essay.title || '');
    setVal('field-description', essay.description || '');
    setVal('field-category', essay.category || '');
    setVal('field-territory', essay.territory || 'para');
    setVal('field-locality', essay.locality || '');
    setVal('field-author', essay.author || 'Thalyson');
    setVal('field-body', essay.body || '');

    const draftCheck = /** @type {HTMLInputElement} */ (document.getElementById('field-draft'));
    if (draftCheck) draftCheck.checked = Boolean(essay.draft);

    const featCheck = /** @type {HTMLInputElement} */ (document.getElementById('field-featured'));
    if (featCheck) featCheck.checked = Boolean(essay.featured);

    state.tags = Array.isArray(essay.tags) ? [...essay.tags] : [];
    renderTags();

    if (essay.coverImage) {
      setExistingImagePreview(essay.coverImage, essay.coverImagePosition || '50% 50%');
    } else {
      removeImage();
    }

    const modeBadge = document.getElementById('editor-header-mode-badge');
    const indicator = document.getElementById('editor-editing-indicator');
    if (modeBadge) modeBadge.style.display = 'none';
    if (indicator) {
      indicator.textContent = `Editando: ${essay.slug}`;
      indicator.style.display = 'inline-block';
    }

    updateDeleteButtonVisibility();
    updatePreview();
    showToast(`Publicação "${essay.title}" carregada para edição.`);
  } catch (err) {
    showFeedback(`Erro ao carregar publicação: ${err.message}`, 'error');
  }
}

function resetToNewPublication() {
  ['field-title','field-description','field-category','field-locality','field-body','field-cover-path'].forEach(id => setVal(id, ''));
  const draftCheck = /** @type {HTMLInputElement} */ (document.getElementById('field-draft'));
  if (draftCheck) draftCheck.checked = false;
  const featCheck = /** @type {HTMLInputElement} */ (document.getElementById('field-featured'));
  if (featCheck) featCheck.checked = false;
  setVal('field-territory', 'para');
  setVal('field-author', 'Thalyson');
  state.tags = [];
  state.currentSlug = null;
  state.originalSlug = null;
  state.pubDate = getTodayDate();
  updatePubDateDisplay();
  renderTags();
  removeImage();
  clearDraft();

  const modeBadge = document.getElementById('editor-header-mode-badge');
  const indicator = document.getElementById('editor-editing-indicator');
  if (modeBadge) modeBadge.style.display = 'inline-block';
  if (indicator) indicator.style.display = 'none';

  updateDeleteButtonVisibility();
  updatePreview();
  showToast('Pronto para criar uma nova publicação.');
}

