let linkInsertTarget = 0;
let linkInsertEnd = 0;

function openLinkDialog() {
  const textarea = /** @type {HTMLTextAreaElement} */ (document.getElementById('field-body'));
  if (textarea) {
    linkInsertTarget = textarea.selectionStart;
    linkInsertEnd = textarea.selectionEnd;
    const selected = textarea.value.substring(linkInsertTarget, linkInsertEnd);
    setVal('link-text', selected || '');
    setVal('link-url', '');
  }
  const overlay = document.getElementById('link-dialog-overlay');
  if (overlay) overlay.classList.add('open');
  document.getElementById('link-text')?.focus();
}

function closeLinkDialog() {
  const overlay = document.getElementById('link-dialog-overlay');
  if (overlay) overlay.classList.remove('open');
}

document.getElementById('btn-cancel-link')?.addEventListener('click', closeLinkDialog);
